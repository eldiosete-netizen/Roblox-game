-- Lobby ------------------------------------------------------------------------------

-- Portal con arco de neón, superficie de energía, luz, partículas y cartel con el nombre
local function buildPortal(portals: Folder, map: Folder, base: Vector3)
	local color = map:GetAttribute("Color") or Color3.new(1, 1, 1)
	local isVip = map:GetAttribute("Vip") == true
	local isTutorial = map:GetAttribute("Tutorial") == true
	local trim = if isVip then Color3.fromRGB(255, 205, 40) else color
	local facing = Vector3.new(0, 0, 1) -- los portales miran hacia el spawn

	local radius = 6.5 -- distancia del centro a cada columna
	local pillarHeight = 13
	local archCenter = base + Vector3.new(0, pillarHeight, 0)

	-- Escalón de la base
	newPart("Part", {
		Name = "Step",
		Size = Vector3.new(radius * 2 + 6, 0.4, 7),
		Position = base + Vector3.new(0, 0.2, 0),
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	}, portals)
	newPart("Part", {
		Name = "StepGlow",
		Size = Vector3.new(radius * 2 + 6, 0.1, 0.4),
		Position = base + Vector3.new(0, 0.45, 3.3),
		Color = trim,
		Material = Enum.Material.Neon,
	}, portals)

	-- Columnas oscuras con una franja de neón delante
	for _, side in { -1, 1 } do
		newPart("Part", {
			Name = "Pillar",
			Size = Vector3.new(2.5, pillarHeight, 2.5),
			Position = base + Vector3.new(side * radius, pillarHeight / 2 + 0.4, 0),
			Color = DARK_METAL,
			Material = Enum.Material.Metal,
		}, portals)
		newPart("Part", {
			Name = "PillarGlow",
			Size = Vector3.new(0.5, pillarHeight - 1, 0.2),
			Position = base + Vector3.new(side * radius, pillarHeight / 2 + 0.4, 1.3),
			Color = trim,
			Material = Enum.Material.Neon,
		}, portals)
	end

	-- Arco de neón (semicírculo hecho con segmentos)
	local segments = 12
	local segmentLength = 2 * radius * math.sin(math.pi / (2 * segments)) * 1.25
	for k = 0, segments - 1 do
		local angle = (k + 0.5) / segments * math.pi
		local position = archCenter + Vector3.new(radius * math.cos(angle), radius * math.sin(angle) + 0.4, 0)
		newPart("Part", {
			Name = "Arch",
			Size = Vector3.new(2.5, segmentLength, 2.5),
			CFrame = CFrame.new(position) * CFrame.Angles(0, 0, angle),
			Color = trim,
			Material = Enum.Material.Neon,
		}, portals)
	end

	-- Superficie de energía (rectángulo + semicírculo). Solo "Portal" detecta al jugador.
	local inner = radius * 2 - 2.5
	local portal = newPart("Part", {
		Name = "Portal",
		Size = Vector3.new(inner, pillarHeight, 0.4),
		Position = base + Vector3.new(0, pillarHeight / 2 + 0.4, 0),
		Color = color,
		Material = Enum.Material.ForceField,
		Transparency = 0.15,
		CanCollide = false,
	}, portals)
	portal:SetAttribute("MapId", map.Name)
	newPart("Part", {
		Name = "PortalTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, inner, inner),
		CFrame = CFrame.new(archCenter + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, math.rad(90), 0),
		Color = color,
		Material = Enum.Material.ForceField,
		Transparency = 0.15,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	}, portals)

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 18
	light.Brightness = 2
	light.Parent = portal
	sparkles(portal, color, Enum.NormalId.Front, 6)

	-- Cartel con el nombre, encima del arco
	local name = map:GetAttribute("DisplayName") or map.Name
	local plateCenter = archCenter + Vector3.new(0, radius + 3.4, 0)
	local plate = newPart("Part", {
		Name = "NamePlate",
		Size = Vector3.new(13, 3, 0.5),
		CFrame = CFrame.lookAt(plateCenter, plateCenter + facing),
		Color = DARK_METAL,
	}, portals)
	namePlate(
		plate,
		if isVip then "⭐ " .. name .. " · VIP" elseif isTutorial then "📘 " .. name else name,
		trim
	)
	if isTutorial then
		billboard(plate, "¡Empieza aquí!", Vector2.new(10, 2), Vector3.new(0, 2.6, 0), Color3.fromRGB(0, 230, 120))
	end

end

-- Zona de rankings: una fila de carteles a la altura de los ojos.
-- "origin" es el centro de la fila en el suelo y "facing" hacia dónde miran.
local function buildRankingWall(lobby: Folder, boards: Folder, maps: { Folder }, origin: Vector3, facing: Vector3)
	local ranked = {}
	for _, map in maps do
		if not map:GetAttribute("Tutorial") then
			table.insert(ranked, map)
		end
	end

	local along = Vector3.yAxis:Cross(facing) -- de izquierda a derecha vista de frente
	local boardSize = Vector3.new(18, 14, 1)
	local spacing = boardSize.X + 4
	local rowLength = #ranked * spacing

	-- Suelo de la zona y muro trasero
	newPart("Part", {
		Name = "RankingFloor",
		Size = Vector3.new(rowLength + 6, 0.2, 16),
		CFrame = CFrame.lookAt(origin + facing * 6 + Vector3.new(0, 0.1, 0), origin + facing * 7 + Vector3.new(0, 0.1, 0)),
		Color = Color3.fromRGB(30, 32, 46),
	}, lobby)
	newPart("Part", {
		Name = "RankingWall",
		Size = Vector3.new(rowLength + 6, 22, 2),
		CFrame = CFrame.lookAt(origin - facing * 1.5 + Vector3.new(0, 11, 0), origin + facing + Vector3.new(0, 11, 0)),
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	}, lobby)

	-- Título de la zona
	local titleCenter = origin + Vector3.new(0, 19, 0) + facing * 0.2
	local title = newPart("Part", {
		Name = "RankingTitle",
		Size = Vector3.new(26, 4, 0.5),
		CFrame = CFrame.lookAt(titleCenter, titleCenter + facing),
		Color = DARK_METAL,
	}, lobby)
	namePlate(title, "🏆 RANKINGS", Color3.fromRGB(255, 205, 40))

	for i, map in ranked do
		local color = map:GetAttribute("Color") or Color3.new(1, 1, 1)
		local offset = (i - (#ranked + 1) / 2) * spacing
		local center = origin + along * offset + Vector3.new(0, boardSize.Y / 2 + 1.5, 0) + facing * 0.5

		local board = newPart("Part", {
			Name = "Board",
			Size = boardSize,
			CFrame = CFrame.lookAt(center, center + facing),
			Color = Color3.fromRGB(20, 20, 30),
		}, boards)
		board:SetAttribute("MapId", map.Name)

		-- Marco de neón del color del mapa
		local frameCenter = center - facing * 0.1
		local frame = CFrame.lookAt(frameCenter, frameCenter + facing)
		local w, h = boardSize.X / 2 + 0.3, boardSize.Y / 2 + 0.3
		for _, piece in {
			{ CFrame.new(0, h, 0), Vector3.new(boardSize.X + 1.2, 0.6, 0.6) },
			{ CFrame.new(0, -h, 0), Vector3.new(boardSize.X + 1.2, 0.6, 0.6) },
			{ CFrame.new(w, 0, 0), Vector3.new(0.6, boardSize.Y + 1.2, 0.6) },
			{ CFrame.new(-w, 0, 0), Vector3.new(0.6, boardSize.Y + 1.2, 0.6) },
		} do
			newPart("Part", {
				Name = "BoardFrame",
				Size = piece[2],
				CFrame = frame * piece[1],
				Color = color,
				Material = Enum.Material.Neon,
			}, lobby)
		end

		-- Luz suave delante del cartel para que se lea bien
		local light = Instance.new("SurfaceLight")
		light.Face = Enum.NormalId.Front
		light.Color = color
		light.Range = 10
		light.Brightness = 0.6
		light.Parent = board
	end
end

-- Plataforma de la carrera en vivo: anillo de neón, partículas y cartel alto en un poste
local function buildLiveRacePad(lobby: Folder, center: Vector3, viewer: Vector3)
	local purple = Color3.fromRGB(170, 80, 255)
	local flat = CFrame.Angles(0, 0, math.rad(90)) -- cilindros tumbados (eje vertical)

	newPart("Part", {
		Name = "LiveRaceRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 22, 22),
		CFrame = CFrame.new(center + Vector3.new(0, 0.25, 0)) * flat,
		Color = purple,
		Material = Enum.Material.Neon,
	}, lobby)
	newPart("Part", {
		Name = "LiveRaceBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 19.5, 19.5),
		CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * flat,
		Color = Color3.fromRGB(28, 20, 42),
	}, lobby)
	local pad = newPart("Part", {
		Name = "LiveRacePad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 15, 15),
		CFrame = CFrame.new(center + Vector3.new(0, 0.35, 0)) * flat,
		Color = Color3.fromRGB(120, 50, 200),
		Material = Enum.Material.Neon,
	}, lobby)
	local light = Instance.new("PointLight")
	light.Color = purple
	light.Range = 20
	light.Brightness = 2
	light.Parent = pad
	-- Con el cilindro tumbado, su cara "Right" mira hacia arriba
	sparkles(pad, Color3.fromRGB(220, 180, 255), Enum.NormalId.Right, 15)

	-- Poste detrás del círculo (visto desde el spawn) con el cartel bien alto
	local away = Vector3.new(center.X - viewer.X, 0, center.Z - viewer.Z).Unit
	local postBase = center + away * 13
	newPart("Part", {
		Name = "LiveRacePost",
		Size = Vector3.new(1.5, 18, 1.5),
		Position = postBase + Vector3.new(0, 9, 0),
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	}, lobby)
	local signCenter = postBase + Vector3.new(0, 19, 0) - away * 0.8
	local sign = newPart("Part", {
		Name = "LiveRaceSign",
		Size = Vector3.new(22, 5, 0.6),
		CFrame = CFrame.lookAt(signCenter, signCenter - away),
		Color = DARK_METAL,
	}, lobby)
	namePlate(sign, "🏁 CARRERA EN VIVO", purple)
	billboard(
		sign,
		"Pisa el círculo para unirte",
		Vector2.new(14, 1.8),
		Vector3.new(0, -3.8, 0),
		Color3.fromRGB(220, 180, 255)
	)
end

local function buildLobby(maps: { Folder }): Folder
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	local y = Config.CourseHeight

	newPart("Part", {
		Name = "Floor",
		Size = Vector3.new(170, 2, 140),
		Position = Vector3.new(0, y - 1, -5),
		Color = Color3.fromRGB(45, 48, 62),
	}, lobby)

	newPart("SpawnLocation", {
		Name = "Spawn",
		Size = Vector3.new(12, 1, 12),
		Position = Vector3.new(0, y + 0.5, 20),
		Color = Color3.fromRGB(0, 170, 255),
		Material = Enum.Material.Neon,
		Neutral = true,
		Duration = 0,
	}, lobby)

	local portals = Instance.new("Folder")
	portals.Name = "Portals"
	portals.Parent = lobby
	local boards = Instance.new("Folder")
	boards.Name = "Boards"
	boards.Parent = lobby

	table.sort(maps, function(a, b)
		return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
	end)

	local spacing = 28
	for i, map in maps do
		local x = (i - (#maps + 1) / 2) * spacing
		buildPortal(portals, map, Vector3.new(x, y, -45))
	end

	-- Rankings detrás del spawn (no tapan los portales ni la carrera en vivo)
	buildRankingWall(lobby, boards, maps, Vector3.new(0, y, 58), Vector3.new(0, 0, -1))

	buildLiveRacePad(lobby, Vector3.new(58, y, 0), Vector3.new(0, y, 20))

	LobbyDecor.build(lobby, y)

	lobby.Parent = workspace
	return lobby
end

function CourseBuilder.buildAll(): (Folder, Folder)
	-- Desactiva otros spawns (p. ej. el de la plantilla Baseplate) para aparecer en el lobby
	for _, descendant in workspace:GetDescendants() do
		if descendant:IsA("SpawnLocation") then
			descendant.Enabled = false
		end
	end

	local mapsFolder = Instance.new("Folder")
	mapsFolder.Name = "Maps"
	mapsFolder.Parent = workspace

	local built = {}
	for i, definition in CourseBuilder.Definitions do
		local builder = MapBuilder.new(mapsFolder, definition.id, definition.attributes, i * Config.MapSpacing, definition.theme)
		definition.build(builder)
		table.insert(built, builder.folder)
	end

	local lobby = buildLobby(built)
	return mapsFolder, lobby
end

return CourseBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Monedas, XP y niveles: recompensas al terminar mapas y carreras en vivo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local RaceService = require(script.Parent:WaitForChild("RaceService"))
local LiveRace = require(script.Parent:WaitForChild("LiveRace"))

local Economy = {}

local LEVEL_COLOR = Color3.fromRGB(0, 230, 120)

-- Da monedas y XP. Si se pasa "rewards", anota lo ganado para mostrarlo al jugador.
function Economy.give(player: Player, coins: number, xp: number, rewards: { [string]: any }?)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	if PlayerData.session(player).vip then
		coins = math.floor(coins * Config.VipCoinMultiplier)
	end

	local oldLevel = Config.LevelFromXP(data.xp)
	data.coins += coins
	data.xp += xp
	local newLevel = Config.LevelFromXP(data.xp)

	if rewards then
		rewards.coins = (rewards.coins or 0) + coins
		rewards.xp = (rewards.xp or 0) + xp
	end
	if newLevel > oldLevel then
		if rewards then
			rewards.levelUp = newLevel
		end
		task.delay(2.5, function()
			Remotes.Notify:FireClient(player, string.format("⬆ ¡Nivel %d!", newLevel), LEVEL_COLOR)
		end)
	end
	PlayerData.sync(player)
end

-- Gasta monedas. Devuelve false si no hay suficientes.
function Economy.spend(player: Player, amount: number): boolean
	local data = PlayerData.get(player)
	if not data or data.coins < amount then
		return false
	end
	data.coins -= amount
	PlayerData.sync(player)
	return true
end

function Economy.init()
	local rewards = Config.Rewards

	RaceService.onFinish(function(player, map, result)
		local data = PlayerData.get(player)
		if not data then
			return
		end
		local coins, xp = 0, rewards.FinishXP

		if map.tutorial then
			if not data.tutorialDone then
				data.tutorialDone = true
				coins += rewards.TutorialCoins
			end
		else
			coins += rewards.FinishCoins
			if result.previousBest == nil then
				coins += rewards.FirstFinishCoins
			elseif result.isRecord then
				coins += rewards.RecordCoins
				xp += rewards.RecordXP
			end
			-- Medallas nuevas (solo se cobran la primera vez)
			for rank = result.previousMedal + 1, result.medal do
				coins += rewards.MedalCoins[rank] or 0
			end
			xp += result.medal * rewards.MedalXP
		end

		Economy.give(player, coins, xp, result.rewards)
	end)

	LiveRace.onRaceEnd(function(player, place, _total)
		local coins = if place then rewards.LivePlaceCoins[place] or rewards.LiveParticipationCoins else rewards.LiveParticipationCoins
		Economy.give(player, coins, rewards.LiveXP)
		Remotes.Notify:FireClient(
			player,
			string.format("🏁 Carrera en vivo: %s  ·  +%d monedas", if place then place .. "º puesto" else "sin terminar", coins)
		)
	end)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Ghosts</string>
          <string name="Source"><![CDATA[-- Guarda y envía el "fantasma" (tu mejor intento grabado) de cada mapa.
-- El cliente graba sus posiciones; el servidor solo acepta el fantasma
-- justo después de un récord válido.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local RaceService = require(script.Parent:WaitForChild("RaceService"))

local Ghosts = {}

local MAX_LENGTH = Config.GhostMaxSamples * 40

local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStores.Ghosts)
end)

local cache: { [Player]: { [string]: string | false } } = {}
local pending: { [Player]: { mapId: string, expires: number } } = {}

local function key(player: Player, mapId: string): string
	return player.UserId .. "_" .. mapId
end

local function load(player: Player, mapId: string)
	local playerCache = cache[player]
	if not playerCache then
		return
	end
	if playerCache[mapId] == nil then
		playerCache[mapId] = false
		if store then
			local ok, value = pcall(function()
				return store:GetAsync(key(player, mapId))
			end)
			if ok and typeof(value) == "string" then
				playerCache[mapId] = value
			end
		end
	end
	local ghost = playerCache[mapId]
	if player:GetAttribute("MapId") == mapId then
		Remotes.GhostData:FireClient(player, mapId, if ghost then ghost else nil)
	end
end

function Ghosts.init()
	local function onPlayerAdded(player: Player)
		cache[player] = {}
		-- Al entrar en un mapa, enviamos su fantasma
		player:GetAttributeChangedSignal("MapId"):Connect(function()
			local mapId = player:GetAttribute("MapId")
			if typeof(mapId) == "string" then
				task.spawn(load, player, mapId)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
		pending[player] = nil
	end)

	RaceService.onFinish(function(player, map, result)
		if result.isRecord and not map.tutorial then
			pending[player] = { mapId = map.id, expires = os.clock() + 15 }
		end
	end)

	Remotes.SubmitGhost.OnServerEvent:Connect(function(player, mapId, encoded)
		local expected = pending[player]
		if not expected or expected.mapId ~= mapId or os.clock() > expected.expires then
			return
		end
		if typeof(encoded) ~= "string" or #encoded == 0 or #encoded > MAX_LENGTH then
			return
		end
		pending[player] = nil
		if cache[player] then
			cache[player][mapId] = encoded
		end
		if store then
			task.spawn(function()
				local ok, err = pcall(function()
					store:SetAsync(key(player, mapId), encoded, { player.UserId })
				end)
				if not ok then
					warn("[Ghosts] No se pudo guardar el fantasma:", err)
				end
			end)
		end
	end)
end

return Ghosts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[-- Ranking global por mapa (OrderedDataStore) y carteles del lobby.
-- Sin acceso a DataStore, el ranking funciona con los tiempos de la sesión.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Leaderboard = {}

export type Entry = { userId: number, name: string, seconds: number }

type Board = {
	week: number, -- semana a la que pertenecen los datos "week"
	cached: { [string]: { [number]: number } }, -- último resultado del DataStore
	session: { [string]: { [number]: number } }, -- tiempos de esta sesión
	renderers: { () -> () },
}

local boards: { [string]: Board } = {}
local names: { [number]: string } = {}

-- "all" = histórico, "week" = esta semana (se reinicia cada lunes, hora UTC)
local PERIODS = { "all", "week" }
local PERIOD_TITLES = { all = "Histórico", week = "Esta semana" }

local function currentWeek(): number
	-- El 1 de enero de 1970 fue jueves: +3 días para que la semana empiece en lunes
	return math.floor((os.time() + 3 * 86400) / (7 * 86400))
end

local function storeName(mapId: string, period: string): string
	if period == "week" then
		return Config.DataStores.TimesPrefix .. mapId .. "_W" .. currentWeek()
	end
	return Config.DataStores.TimesPrefix .. mapId
end

local function getBoard(mapId: string): Board
	local board = boards[mapId]
	if board then
		-- Nueva semana: el ranking semanal empieza de cero
		if board.week ~= currentWeek() then
			board.week = currentWeek()
			board.cached.week = {}
			board.session.week = {}
		end
		return board
	end
	board = { week = currentWeek(), cached = {}, session = {}, renderers = {} }
	for _, period in PERIODS do
		board.cached[period] = {}
		board.session[period] = {}
	end
	boards[mapId] = board
	return board
end

local storeCache: { [string]: any } = {} -- nombre -> OrderedDataStore | false

local function getStore(mapId: string, period: string): OrderedDataStore?
	local name = storeName(mapId, period)
	if storeCache[name] == nil then
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, name)
		storeCache[name] = if ok then store else false
	end
	return storeCache[name] or nil
end

local function getName(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	names[userId] = if ok then name else "Jugador"
	return names[userId]
end

local function render(mapId: string)
	for _, renderer in getBoard(mapId).renderers do
		task.spawn(renderer)
	end
end

function Leaderboard.submit(player: Player, mapId: string, seconds: number)
	local board = getBoard(mapId)
	local userId = player.UserId
	names[userId] = player.Name
	local ms = math.floor(seconds * 1000 + 0.5)

	for _, period in PERIODS do
		local session = board.session[period]
		if not session[userId] or seconds < session[userId] then
			session[userId] = seconds
		end
		local store = getStore(mapId, period)
		if store then
			task.spawn(function()
				local ok, err = pcall(function()
					store:UpdateAsync(tostring(userId), function(old)
						if typeof(old) == "number" and old <= ms then
							return nil
						end
						return ms
					end)
				end)
				if not ok then
					warn("[Leaderboard] No se pudo guardar el tiempo:", err)
				end
			end)
		end
	end
	render(mapId)
end

-- Lee el DataStore (gasta peticiones; se llama cada LeaderboardRefresh)
local function fetch(mapId: string, period: string)
	local store = getStore(mapId, period)
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(true, Config.LeaderboardSize)
	end)
	if not ok then
		return
	end
	local result = {}
	for _, item in pages:GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			result[userId] = item.value / 1000
		end
	end
	getBoard(mapId).cached[period] = result
end

function Leaderboard.getTop(mapId: string, period: string, count: number): { Entry }
	local board = getBoard(mapId)
	local merged: { [number]: number } = {}
	for userId, seconds in board.cached[period] or {} do
		merged[userId] = seconds
	end
	for userId, seconds in board.session[period] or {} do
		if not merged[userId] or seconds < merged[userId] then
			merged[userId] = seconds
		end
	end

	local list = {}
	for userId, seconds in merged do
		table.insert(list, { userId = userId, seconds = seconds, name = "" })
	end
	table.sort(list, function(a, b)
		return a.seconds < b.seconds
	end)

	local result = {}
	for i = 1, math.min(count, #list) do
		list[i].name = getName(list[i].userId)
		result[i] = list[i]
	end
	return result
end

local function makeLabel(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

-- Dibuja el ranking de un mapa en la cara frontal de una Part
function Leaderboard.startBoard(part: BasePart, mapId: string, title: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	frame.BorderSizePixel = 0
	frame.Parent = gui

	makeLabel(frame, {
		Size = UDim2.new(1, -40, 0, 70),
		Position = UDim2.fromOffset(20, 10),
		Font = Enum.Font.GothamBlack,
		TextColor3 = color,
		Text = "🏆 " .. title,
	})

	local columns = {}
	for i, period in PERIODS do
		local column = Instance.new("Frame")
		column.BackgroundTransparency = 1
		column.Size = UDim2.new(1 / #PERIODS, -30, 1, -100)
		column.Position = UDim2.new((i - 1) / #PERIODS, 20, 0, 90)
		column.Parent = frame

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 4)
		layout.Parent = column

		makeLabel(column, {
			Size = UDim2.new(1, 0, 0, 44),
			Font = Enum.Font.GothamBlack,
			TextColor3 = Color3.fromRGB(170, 170, 190),
			Text = PERIOD_TITLES[period],
			LayoutOrder = 0,
		})

		local rows = {}
		for rank = 1, Config.LeaderboardSize do
			rows[rank] = makeLabel(column, {
				Size = UDim2.new(1, 0, 0, 46),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = if rank <= 3 then Color3.new(1, 1, 1) else Color3.fromRGB(170, 170, 190),
				Text = string.format("%d. ---", rank),
				LayoutOrder = rank,
			})
		end
		columns[period] = rows
	end

	local function draw()
		for period, rows in columns do
			local top = Leaderboard.getTop(mapId, period, Config.LeaderboardSize)
			for rank, row in rows do
				local entry = top[rank]
				row.Text = if entry
					then string.format("%d. %s  %s", rank, entry.name, Config.FormatTime(entry.seconds))
					else string.format("%d. ---", rank)
			end
		end
	end
	table.insert(getBoard(mapId).renderers, draw)

	task.spawn(function()
		while part.Parent do
			for period in columns do
				fetch(mapId, period)
			end
			draw()
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">LiveRace</string>
          <string name="Source"><![CDATA[-- Carreras en vivo: los jugadores en la cola corren a la vez en un mapa al azar.
-- Fases: waiting (esperando jugadores) -> intermission (cuenta atrás) ->
-- racing -> results -> waiting

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Maps = require(script.Parent:WaitForChild("Maps"))
local RaceService = require(script.Parent:WaitForChild("RaceService"))

local LiveRace = {}

type Finisher = { player: Player, name: string, time: number }

local queue: { [Player]: boolean } = {}
local participants: { [Player]: boolean } = {}
local finishers: { Finisher } = {}
local phase = "waiting"
local currentMap: Maps.MapInfo? = nil
local raceStart = 0

local raceEndHandlers: { (Player, number?, number) -> () } = {}

-- Se llama al terminar cada carrera: (jugador, puesto o nil si no terminó, participantes)
function LiveRace.onRaceEnd(handler: (Player, number?, number) -> ())
	table.insert(raceEndHandlers, handler)
end

local function count(set: { [Player]: boolean }): number
	local n = 0
	for _ in set do
		n += 1
	end
	return n
end

local function publicResults(): { { name: string, time: number } }
	local list = {}
	for _, finisher in finishers do
		table.insert(list, { name = finisher.name, time = finisher.time })
	end
	return list
end

local function broadcast(status: { [string]: any })
	local sent: { [Player]: boolean } = {}
	for _, set in { queue, participants } do
		for player in set do
			if not sent[player] then
				sent[player] = true
				Remotes.LiveRaceUpdate:FireClient(player, status)
			end
		end
	end
end

function LiveRace.setQueued(player: Player, join: boolean): (boolean, string?)
	if participants[player] then
		return false, "Ya estás en una carrera en vivo"
	end
	if join then
		queue[player] = true
		Remotes.LiveRaceUpdate:FireClient(player, { phase = phase, queued = count(queue), needed = Config.LiveRace.MinPlayers })
		return true, "Te has unido a la carrera en vivo"
	end
	queue[player] = nil
	Remotes.LiveRaceUpdate:FireClient(player, { phase = "none" })
	return true, nil
end

local function startRace()
	local candidates = {}
	for _, map in Maps.list() do
		if not map.vip and not map.tutorial then
			table.insert(candidates, map)
		end
	end
	if #candidates == 0 then
		phase = "waiting"
		return
	end
	local map = candidates[math.random(#candidates)]
	currentMap = map
	table.clear(finishers)
	table.clear(participants)

	for player in queue do
		if RaceService.enterMap(player, map.id, "live") then
			participants[player] = true
		end
	end
	table.clear(queue)

	task.wait(0.5)
	for player in participants do
		RaceService.beginCountdown(player)
	end
	raceStart = os.clock() + Config.CountdownSeconds
	phase = "racing"
end

local function endRace()
	local total = count(participants)
	local places: { [Player]: number } = {}
	for place, finisher in finishers do
		places[finisher.player] = place
	end
	broadcast({ phase = "results", map = currentMap and currentMap.name, results = publicResults() })

	for player in participants do
		for _, handler in raceEndHandlers do
			handler(player, places[player], total)
		end
		RaceService.setMode(player, "solo")
	end
	table.clear(participants)
	table.clear(finishers)
	currentMap = nil
	phase = "waiting"
end

function LiveRace.init()
	Remotes.SetLiveRaceQueue.OnServerInvoke = function(player, join)
		return LiveRace.setQueued(player, join == true)
	end

	-- Plataforma del lobby
	local pad = Maps.lobby():FindFirstChild("LiveRacePad")
	if pad and pad:IsA("BasePart") then
		pad.Touched:Connect(function(hit)
			local model = hit:FindFirstAncestorOfClass("Model")
			local player = model and Players:GetPlayerFromCharacter(model)
			if player and not queue[player] and not participants[player] then
				local _, message = LiveRace.setQueued(player, true)
				if message then
					Remotes.Notify:FireClient(player, message)
				end
			end
		end)
	end

	RaceService.onFinish(function(player, map, result)
		if phase ~= "racing" or not participants[player] or not currentMap or map.id ~= currentMap.id then
			return
		end
		for _, finisher in finishers do
			if finisher.player == player then
				return
			end
		end
		table.insert(finishers, { player = player, name = player.DisplayName, time = result.time })
		result.rewards.place = #finishers
	end)

	-- Si se va a otro mapa o al lobby, abandona la carrera
	RaceService.onLeaveMap(function(player)
		participants[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		queue[player] = nil
		participants[player] = nil
	end)

	task.spawn(function()
		local timer = 0
		while true do
			if phase == "waiting" then
				if count(queue) >= Config.LiveRace.MinPlayers then
					phase = "intermission"
					timer = Config.LiveRace.Intermission
				else
					broadcast({ phase = "waiting", queued = count(queue), needed = Config.LiveRace.MinPlayers })
				end
			elseif phase == "intermission" then
				if count(queue) < Config.LiveRace.MinPlayers then
					phase = "waiting"
				elseif timer <= 0 then
					startRace()
				else
					broadcast({ phase = "intermission", queued = count(queue), timeLeft = timer })
					timer -= 1
				end
			elseif phase == "racing" then
				local elapsed = os.clock() - raceStart
				local everyoneDone = count(participants) == 0 or #finishers >= count(participants)
				if everyoneDone or elapsed > Config.LiveRace.TimeLimit then
					endRace()
				else
					broadcast({
						phase = "racing",
						map = currentMap and currentMap.name,
						timeLeft = math.max(0, math.ceil(Config.LiveRace.TimeLimit - elapsed)),
						results = publicResults(),
					})
				end
			end
			task.wait(1)
		end
	end)
end

return LiveRace
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">LobbyDecor</string>
          <string name="Source"><![CDATA[-- Decoración del lobby: plaza central, suelo con rejilla de neón, muros con
-- cristal, farolas, árboles, bancos, anillos holográficos, título gigante,
-- ciudad de fondo e iluminación.
--
-- Distribución del lobby (y = altura del suelo):
--   suelo x -85..85, z -75..65 · spawn (0, 20) · portales en z = -45
--   carrera en vivo en (58, 0) · pared de rankings en z = 58

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local BuildUtil = require(script.Parent:WaitForChild("BuildUtil"))

local newPart = BuildUtil.newPart
local DARK_METAL = BuildUtil.DarkMetal

local LobbyDecor = {}

local FLOOR_MIN = Vector2.new(-85, -75) -- (x, z)
local FLOOR_MAX = Vector2.new(85, 65)
local SPAWN = Vector2.new(0, 20)

local CYAN = Color3.fromRGB(0, 200, 255)
local PURPLE = Color3.fromRGB(170, 80, 255)
local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- cilindro con el eje vertical

-- Anillo hecho con segmentos (en el plano XY local de "frame")
local function ring(parent: Instance, frame: CFrame, radius: number, thickness: number, color: Color3, segments: number)
	local length = 2 * radius * math.sin(math.pi / segments) * 1.1
	for k = 0, segments - 1 do
		local angle = k / segments * math.pi * 2
		newPart("Part", {
			Name = "RingSegment",
			Size = Vector3.new(thickness, length, thickness),
			CFrame = frame * CFrame.new(radius * math.cos(angle), radius * math.sin(angle), 0) * CFrame.Angles(0, 0, angle),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		}, parent)
	end
end

-- Plaza central alrededor del spawn
local function plaza(lobby: Folder, y: number)
	local center = Vector3.new(SPAWN.X, y, SPAWN.Y)
	newPart("Part", {
		Name = "PlazaRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, 38, 38),
		CFrame = CFrame.new(center + Vector3.new(0, 0.06, 0)) * FLAT,
		Color = CYAN,
		Material = Enum.Material.Neon,
	}, lobby)
	newPart("Part", {
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.16, 36, 36),
		CFrame = CFrame.new(center + Vector3.new(0, 0.08, 0)) * FLAT,
		Color = Color3.fromRGB(32, 35, 50),
		Material = Enum.Material.Slate,
	}, lobby)

	-- Anillos holográficos que giran sobre el spawn (los anima el cliente)
	local hologram = Instance.new("Model")
	hologram.Name = "Hologram"
	local holoCenter = CFrame.new(center + Vector3.new(0, 16, 0))
	ring(hologram, holoCenter, 6, 0.4, CYAN, 20)
	ring(hologram, holoCenter * CFrame.Angles(math.rad(90), 0, 0), 4.5, 0.35, PURPLE, 16)
	ring(hologram, holoCenter * CFrame.Angles(0, math.rad(90), 0), 3, 0.3, Color3.fromRGB(255, 205, 40), 14)
	local core = newPart("Part", {
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2, 2, 2),
		CFrame = holoCenter,
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, hologram)
	local light = Instance.new("PointLight")
	light.Color = CYAN
	light.Range = 24
	light.Brightness = 1.5
	light.Parent = core
	hologram.PrimaryPart = core
	hologram:SetAttribute("SpinSpeed", 25) -- grados por segundo
	CollectionService:AddTag(hologram, "Spinner")
	hologram.Parent = lobby
end

-- Rejilla de neón tenue en el suelo
local function floorGrid(lobby: Folder, y: number)
	local grid = Instance.new("Folder")
	grid.Name = "FloorGrid"
	grid.Parent = lobby
	local props = {
		Color = Color3.fromRGB(40, 90, 160),
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}
	for x = FLOOR_MIN.X + 10, FLOOR_MAX.X - 10, 20 do
		props.Size = Vector3.new(0.25, 0.04, FLOOR_MAX.Y - FLOOR_MIN.Y - 4)
		props.Position = Vector3.new(x, y + 0.02, (FLOOR_MIN.Y + FLOOR_MAX.Y) / 2)
		newPart("Part", table.clone(props), grid)
	end
	for z = FLOOR_MIN.Y + 15, FLOOR_MAX.Y - 10, 20 do
		props.Size = Vector3.new(FLOOR_MAX.X - FLOOR_MIN.X - 4, 0.04, 0.25)
		props.Position = Vector3.new(0, y + 0.02, z)
		newPart("Part", table.clone(props), grid)
	end
end

-- Muro bajo con cristal y franja de neón alrededor del lobby
local function perimeter(lobby: Folder, y: number)
	local walls = Instance.new("Folder")
	walls.Name = "Perimeter"
	walls.Parent = lobby
	local width = FLOOR_MAX.X - FLOOR_MIN.X
	local depth = FLOOR_MAX.Y - FLOOR_MIN.Y
	local midZ = (FLOOR_MIN.Y + FLOOR_MAX.Y) / 2
	local sides = {
		{ position = Vector3.new(0, 0, FLOOR_MIN.Y), size = Vector3.new(width, 0, 1) },
		{ position = Vector3.new(0, 0, FLOOR_MAX.Y), size = Vector3.new(width, 0, 1) },
		{ position = Vector3.new(FLOOR_MIN.X, 0, midZ), size = Vector3.new(1, 0, depth) },
		{ position = Vector3.new(FLOOR_MAX.X, 0, midZ), size = Vector3.new(1, 0, depth) },
	}
	for _, side in sides do
		local base = side.position + Vector3.new(0, y, 0)
		newPart("Part", {
			Name = "WallBase",
			Size = side.size + Vector3.new(0, 3, 0),
			Position = base + Vector3.new(0, 1.5, 0),
			Color = DARK_METAL,
			Material = Enum.Material.Metal,
		}, walls)
		newPart("Part", {
			Name = "WallGlass",
			Size = Vector3.new(math.max(side.size.X - 0.6, 0.4), 6, math.max(side.size.Z - 0.6, 0.4)),
			Position = base + Vector3.new(0, 6, 0),
			Color = Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.75,
		}, walls)
		newPart("Part", {
			Name = "WallGlow",
			Size = side.size + Vector3.new(0, 0.3, 0) + Vector3.new(0.2, 0, 0.2),
			Position = base + Vector3.new(0, 3.1, 0),
			Color = CYAN,
			Material = Enum.Material.Neon,
		}, walls)
	end
end

-- Farola de neón
local function lamp(parent: Instance, position: Vector3, color: Color3)
	newPart("Part", {
		Name = "LampPost",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(10, 0.8, 0.8),
		CFrame = CFrame.new(position + Vector3.new(0, 5, 0)) * FLAT,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	}, parent)
	local head = newPart("Part", {
		Name = "LampHead",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.8, 1.8, 1.8),
		Position = position + Vector3.new(0, 10.5, 0),
		Color = color,
		Material = Enum.Material.Neon,
	}, parent)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 16
	light.Brightness = 1.2
	light.Parent = head
end

local function lamps(lobby: Folder, y: number)
	local folder = Instance.new("Folder")
	folder.Name = "Lamps"
	folder.Parent = lobby
	local positions = {
		-- A lo largo de los muros laterales
		Vector2.new(-80, -50), Vector2.new(-80, -25), Vector2.new(-80, 10), Vector2.new(-80, 40),
		Vector2.new(80, -50), Vector2.new(80, -25), Vector2.new(80, 25), Vector2.new(80, 40),
		-- Alrededor de la plaza
		Vector2.new(-20, 4), Vector2.new(20, 4), Vector2.new(-20, 36), Vector2.new(20, 36),
	}
	for i, p in positions do
		lamp(folder, Vector3.new(p.X, y, p.Y), if i % 2 == 0 then CYAN else PURPLE)
	end
end

-- Árbol estilizado en una jardinera
local function tree(parent: Instance, position: Vector3, scale: number)
	newPart("Part", {
		Name = "Planter",
		Size = Vector3.new(6, 1.6, 6),
		Position = position + Vector3.new(0, 0.8, 0),
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	}, parent)
	newPart("Part", {
		Name = "PlanterGlow",
		Size = Vector3.new(6.2, 0.2, 6.2),
		Position = position + Vector3.new(0, 1.6, 0),
		Color = Color3.fromRGB(0, 230, 120),
		Material = Enum.Material.Neon,
	}, parent)
	newPart("Part", {
		Name = "Soil",
		Size = Vector3.new(5.2, 0.2, 5.2),
		Position = position + Vector3.new(0, 1.65, 0),
		Color = Color3.fromRGB(60, 45, 35),
		Material = Enum.Material.Ground,
	}, parent)
	newPart("Part", {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7 * scale, 1, 1),
		CFrame = CFrame.new(position + Vector3.new(0, 1.6 + 3.5 * scale, 0)) * FLAT,
		Color = Color3.fromRGB(95, 65, 45),
		Material = Enum.Material.Wood,
	}, parent)
	local leaves = {
		{ Vector3.new(0, 8, 0), 6 },
		{ Vector3.new(1.6, 6.8, 0.8), 4.2 },
		{ Vector3.new(-1.4, 7, -1), 4.4 },
	}
	for _, leaf in leaves do
		newPart("Part", {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * leaf[2] * scale,
			Position = position + leaf[1] * scale + Vector3.new(0, 1.6, 0),
			Color = Color3.fromRGB(60, 170, 90),
			Material = Enum.Material.Grass,
		}, parent)
	end
end

-- Banco en el que los jugadores pueden sentarse
local function bench(parent: Instance, position: Vector3, lookAt: Vector3)
	local frame = CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z))
	local seat = Instance.new("Seat")
	seat.Name = "Bench"
	seat.Anchored = true
	seat.Size = Vector3.new(6, 0.5, 2)
	seat.CFrame = frame * CFrame.new(0, 1.6, 0)
	seat.Color = Color3.fromRGB(120, 85, 60)
	seat.Material = Enum.Material.Wood
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.Parent = parent
	newPart("Part", {
		Name = "BenchBack",
		Size = Vector3.new(6, 2, 0.4),
		CFrame = frame * CFrame.new(0, 2.8, 0.9),
		Color = Color3.fromRGB(120, 85, 60),
		Material = Enum.Material.Wood,
	}, parent)
	for _, side in { -2.5, 2.5 } do
		newPart("Part", {
			Name = "BenchLeg",
			Size = Vector3.new(0.4, 1.4, 1.8),
			CFrame = frame * CFrame.new(side, 0.7, 0),
			Color = DARK_METAL,
			Material = Enum.Material.Metal,
		}, parent)
	end
end

local function garden(lobby: Folder, y: number)
	local folder = Instance.new("Folder")
	folder.Name = "Garden"
	folder.Parent = lobby
	local trees = {
		{ Vector2.new(-30, 22), 1 },
		{ Vector2.new(30, 22), 1 },
		{ Vector2.new(-74, 52), 1.3 },
		{ Vector2.new(74, 52), 1.3 },
		{ Vector2.new(-76, -66), 1.3 },
		{ Vector2.new(76, -66), 1.3 },
		{ Vector2.new(-74, -10), 1.1 },
	}
	for _, t in trees do
		tree(folder, Vector3.new(t[1].X, y, t[1].Y), t[2])
	end
	local plaza = Vector3.new(SPAWN.X, y, SPAWN.Y)
	for _, p in { Vector2.new(-30, 12), Vector2.new(30, 12), Vector2.new(-30, 32), Vector2.new(30, 32) } do
		bench(folder, Vector3.new(p.X, y, p.Y), plaza)
	end
end

-- Título gigante sobre los portales
local function title(lobby: Folder, y: number)
	local center = Vector3.new(0, y + 36, -50)
	local sign = newPart("Part", {
		Name = "Title",
		Size = Vector3.new(70, 9, 1),
		CFrame = CFrame.lookAt(center, center + Vector3.new(0, 0, 1)),
		Color = DARK_METAL,
	}, lobby)
	BuildUtil.namePlate(sign, "PARKOUR DE VELOCIDAD", CYAN)
	for _, side in { -1, 1 } do
		newPart("Part", {
			Name = "TitleCable",
			Size = Vector3.new(0.3, 30, 0.3),
			Position = center + Vector3.new(side * 30, 19, 0),
			Color = DARK_METAL,
			Material = Enum.Material.Metal,
			CanCollide = false,
		}, lobby)
	end
end

-- Edificios con franjas de neón alrededor del lobby (solo decorado)
local function skyline(lobby: Folder, y: number)
	local folder = Instance.new("Folder")
	folder.Name = "Skyline"
	folder.Parent = lobby
	local random = Random.new(2024)
	local colors = { CYAN, PURPLE, Color3.fromRGB(255, 80, 180), Color3.fromRGB(255, 205, 40) }
	local count = 28
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + random:NextNumber(-0.08, 0.08)
		local distance = random:NextNumber(150, 210)
		local width = random:NextNumber(18, 34)
		local depth = random:NextNumber(18, 34)
		local height = random:NextNumber(40, 140)
		local base = Vector3.new(math.cos(angle) * distance, y - 60, math.sin(angle) * distance)
		local totalHeight = height + 60
		local frame = CFrame.lookAt(base, Vector3.new(0, base.Y, 0)) * CFrame.new(0, totalHeight / 2, 0)

		newPart("Part", {
			Name = "Building",
			Size = Vector3.new(width, totalHeight, depth),
			CFrame = frame,
			Color = Color3.fromRGB(22 + random:NextInteger(0, 12), 24 + random:NextInteger(0, 12), 38 + random:NextInteger(0, 16)),
			Material = Enum.Material.Concrete,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, folder)

		local color = colors[random:NextInteger(1, #colors)]
		local bands = random:NextInteger(2, 5)
		for b = 1, bands do
			local bandY = 60 + height * (b / (bands + 1)) - totalHeight / 2
			newPart("Part", {
				Name = "NeonBand",
				Size = Vector3.new(width + 0.4, 0.6, depth + 0.4),
				CFrame = frame * CFrame.new(0, bandY, 0),
				Color = color,
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
			}, folder)
		end
		-- Luz roja en lo alto de los edificios más altos
		if height > 100 then
			newPart("Part", {
				Name = "Beacon",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(2, 2, 2),
				CFrame = frame * CFrame.new(0, totalHeight / 2 + 1, 0),
				Color = Color3.fromRGB(255, 50, 50),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			}, folder)
		end
	end
end

-- Atardecer con algo de brillo para que destaque el neón.
-- Solo añade efectos si el juego no tiene ya los suyos.
function LobbyDecor.applyLighting()
	Lighting.ClockTime = 17.6
	Lighting.Brightness = 2
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 110, 140)
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Haze = 1.5
		atmosphere.Color = Color3.fromRGB(200, 170, 220)
		atmosphere.Decay = Color3.fromRGB(110, 80, 140)
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.7
		bloom.Size = 24
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
end

function LobbyDecor.build(lobby: Folder, y: number)
	plaza(lobby, y)
	floorGrid(lobby, y)
	perimeter(lobby, y)
	lamps(lobby, y)
	garden(lobby, y)
	title(lobby, y)
	skyline(lobby, y)
	LobbyDecor.applyLighting()
end

return LobbyDecor
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="15">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Arranque del servidor: crea los remotes, carga mapas y pone en marcha los sistemas.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) -- crea los RemoteEvents antes que nada

local Server = script.Parent
local PlayerData = require(Server:WaitForChild("PlayerData"))
local Maps = require(Server:WaitForChild("Maps"))
local Leaderboard = require(Server:WaitForChild("Leaderboard"))
local RaceService = require(Server:WaitForChild("RaceService"))
local Ghosts = require(Server:WaitForChild("Ghosts"))
local LiveRace = require(Server:WaitForChild("LiveRace"))
local Economy = require(Server:WaitForChild("Economy"))
local Shop = require(Server:WaitForChild("Shop"))

local Config = require(Shared:WaitForChild("Config"))

Maps.init()

-- Carteles de ranking del lobby
local boards = Maps.lobby():FindFirstChild("Boards")
if boards then
	for _, board in boards:GetChildren() do
		local map = Maps.get(board:GetAttribute("MapId") or "")
		if map and board:IsA("BasePart") then
			Leaderboard.startBoard(board, map.id, map.name, map.folder:GetAttribute("Color") or Color3.new(1, 1, 1))
		end
	end
end

RaceService.init()

-- Rankings para el menú del cliente (usa la caché, no gasta peticiones extra)
Remotes.GetLeaderboard.OnServerInvoke = function(_player, mapId)
	local map = typeof(mapId) == "string" and Maps.get(mapId)
	if not map or map.tutorial then
		return nil
	end
	return {
		all = Leaderboard.getTop(map.id, "all", Config.LeaderboardSize),
		week = Leaderboard.getTop(map.id, "week", Config.LeaderboardSize),
	}
end
Ghosts.init()
LiveRace.init()
Economy.init()
Shop.init()

-- Tabla de jugadores (leaderstats)
local function countMedals(data): number
	local total = 0
	for _, mapData in data.maps do
		total += mapData.medal or 0
	end
	return total
end

local function setupLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	for _, name in { "Nivel", "Monedas", "Medallas" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = leaderstats
	end
	leaderstats.Parent = player
end

Players.PlayerAdded:Connect(setupLeaderstats)
for _, player in Players:GetPlayers() do
	setupLeaderstats(player)
end

-- Se ejecuta en cada sincronización de datos: actualiza la tabla de jugadores
PlayerData.addSnapshotField(function(player, snapshot)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local stats = leaderstats :: any
		stats.Nivel.Value = Config.LevelFromXP(snapshot.xp)
		stats.Monedas.Value = snapshot.coins
		stats.Medallas.Value = countMedals(snapshot)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Maps</string>
          <string name="Source"><![CDATA[-- Registro de mapas: lee Workspace/Maps (o los genera) y el lobby.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

export type MapInfo = {
	id: string,
	folder: Folder,
	name: string,
	order: number,
	vip: boolean,
	tutorial: boolean,
	medals: { [string]: number },
	startPad: BasePart,
	startGate: BasePart,
	finish: BasePart,
	checkpoints: { BasePart },
}

local Maps = {}

local list: { MapInfo } = {}
local byId: { [string]: MapInfo } = {}
local lobby: Instance

local function parse(folder: Folder): MapInfo?
	local startPad = folder:FindFirstChild("StartPad")
	local startGate = folder:FindFirstChild("Start")
	local finish = folder:FindFirstChild("Finish")
	local checkpointsFolder = folder:FindFirstChild("Checkpoints")
	if not (startPad and startGate and finish and checkpointsFolder) then
		warn("[Maps] Al mapa", folder.Name, "le falta StartPad, Start, Finish o Checkpoints")
		return nil
	end

	local checkpoints = {}
	for _, cp in checkpointsFolder:GetChildren() do
		local index = cp:GetAttribute("Index")
		if cp:IsA("BasePart") and typeof(index) == "number" then
			checkpoints[index] = cp
		end
	end

	local medals = {}
	for _, medal in Config.Medals do
		local seconds = folder:GetAttribute(medal.id)
		if typeof(seconds) == "number" then
			medals[medal.id] = seconds
		end
	end

	return {
		id = folder.Name,
		folder = folder,
		name = folder:GetAttribute("DisplayName") or folder.Name,
		order = folder:GetAttribute("Order") or 0,
		vip = folder:GetAttribute("Vip") == true,
		tutorial = folder:GetAttribute("Tutorial") == true,
		medals = medals,
		startPad = startPad,
		startGate = startGate,
		finish = finish,
		checkpoints = checkpoints,
	}
end

function Maps.init()
	local mapsFolder = workspace:FindFirstChild("Maps")
	if mapsFolder then
		lobby = workspace:WaitForChild("Lobby")
	else
		mapsFolder, lobby = CourseBuilder.buildAll()
	end

	for _, folder in mapsFolder:GetChildren() do
		if folder:IsA("Folder") then
			local info = parse(folder)
			if info then
				table.insert(list, info)
				byId[info.id] = info
			end
		end
	end
	table.sort(list, function(a, b)
		return a.order < b.order
	end)
end

function Maps.get(id: string): MapInfo?
	return byId[id]
end

function Maps.list(): { MapInfo }
	return list
end

function Maps.lobby(): Instance
	return lobby
end

-- Posición encima de una plataforma, mirando hacia el circuito
function Maps.onTop(part: BasePart, forward: number?): CFrame
	return part.CFrame * CFrame.new(0, part.Size.Y / 2 + 3, -(forward or 0))
end

function Maps.lobbySpawn(): CFrame
	local spawn = lobby:FindFirstChild("Spawn") :: BasePart
	return Maps.onTop(spawn)
end

-- Justo delante de la línea de salida
function Maps.startLine(map: MapInfo): CFrame
	return map.startGate.CFrame * CFrame.new(0, -map.startGate.Size.Y / 2 + 3, -4)
end

function Maps.checkpointCFrame(cp: BasePart): CFrame
	return cp.CFrame * CFrame.new(0, -cp.Size.Y / 2 + 3, 0)
end

return Maps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[-- Datos guardados de cada jugador (DataStore) y sincronización con su cliente.
-- Si el DataStore no está disponible (Studio sin acceso a API), el juego
-- funciona igual pero no se guarda nada entre sesiones.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local PlayerData = {}

local DEFAULT = {
	coins = 0,
	xp = 0,
	maps = {}, -- [mapId] = { best = segundos, splits = {...}, medal = rango, runs = n }
	owned = {}, -- [itemId] = true
	equipped = {}, -- [tipo] = itemId
	settings = {},
	tutorialDone = false,
}

local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStores.Player)
end)

type Profile = { data: { [string]: any }, canSave: boolean, dirty: boolean }

local profiles: { [Player]: Profile } = {}
local session: { [Player]: { [string]: any } } = {} -- datos que no se guardan (VIP, etc.)
local snapshotBuilders: { (Player, { [string]: any }) -> () } = {}
local loadedCallbacks: { (Player, { [string]: any }) -> () } = {}

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- Añade los campos que falten (por ejemplo, tras una actualización del juego)
local function reconcile(data: { [string]: any }, template: { [string]: any })
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif typeof(value) == "table" and typeof(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
end

local function key(player: Player): string
	return "player_" .. player.UserId
end

function PlayerData.load(player: Player): { [string]: any }
	local data = nil
	local canSave = store ~= nil

	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				data = result
				break
			elseif attempt == 3 then
				warn("[PlayerData] No se pudieron cargar los datos de", player.Name, result)
				canSave = false -- no sobrescribir datos buenos con datos vacíos
			else
				task.wait(1)
			end
		end
	end

	if typeof(data) ~= "table" then
		data = {}
	end
	reconcile(data, DEFAULT)

	profiles[player] = { data = data, canSave = canSave, dirty = false }
	session[player] = session[player] or {}
	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
	PlayerData.sync(player)
	return data
end

function PlayerData.get(player: Player): { [string]: any }?
	local profile = profiles[player]
	return profile and profile.data
end

-- Espera a que los datos estén cargados (máx. 10 s)
function PlayerData.wait(player: Player): { [string]: any }?
	local start = os.clock()
	while not profiles[player] and player.Parent and os.clock() - start < 10 do
		task.wait(0.1)
	end
	return PlayerData.get(player)
end

function PlayerData.session(player: Player): { [string]: any }
	session[player] = session[player] or {}
	return session[player]
end

function PlayerData.onLoaded(callback: (Player, { [string]: any }) -> ())
	table.insert(loadedCallbacks, callback)
end

-- Otros módulos pueden añadir campos calculados a lo que recibe el cliente
function PlayerData.addSnapshotField(builder: (Player, { [string]: any }) -> ())
	table.insert(snapshotBuilders, builder)
end

local syncQueued: { [Player]: boolean } = {}

-- Marca los datos como cambiados y los envía al cliente (agrupado por frame)
function PlayerData.sync(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.dirty = true
	if syncQueued[player] then
		return
	end
	syncQueued[player] = true
	task.defer(function()
		syncQueued[player] = nil
		local current = profiles[player]
		if not current or not player.Parent then
			return
		end
		local snapshot = deepCopy(current.data)
		for _, builder in snapshotBuilders do
			builder(player, snapshot)
		end
		Remotes.DataSync:FireClient(player, snapshot)
	end)
end

function PlayerData.save(player: Player)
	local profile = profiles[player]
	if not profile or not profile.canSave or not profile.dirty or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), profile.data, { player.UserId })
	end)
	if ok then
		profile.dirty = false
	else
		warn("[PlayerData] No se pudieron guardar los datos de", player.Name, err)
	end
end

function PlayerData.release(player: Player)
	PlayerData.save(player)
	profiles[player] = nil
	session[player] = nil
end

-- task.defer: deja que los demás módulos registren sus callbacks antes de cargar
Players.PlayerAdded:Connect(function(player)
	task.defer(PlayerData.load, player)
end)
for _, player in Players:GetPlayers() do
	task.defer(PlayerData.load, player)
end
Players.PlayerRemoving:Connect(PlayerData.release)

-- El cliente pide sus datos al arrancar (por si se perdió el primer envío)
Remotes.DataSync.OnServerEvent:Connect(function(player)
	PlayerData.sync(player)
end)

-- Ajustes del jugador (solo claves conocidas y valores sí/no)
Remotes.UpdateSetting.OnServerEvent:Connect(function(player, settingKey, value)
	local profile = profiles[player]
	if not profile or typeof(settingKey) ~= "string" or typeof(value) ~= "boolean" then
		return
	end
	if Config.DefaultSettings[settingKey] == nil then
		return
	end
	profile.data.settings[settingKey] = value
	PlayerData.sync(player)
end)

task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for player in profiles do
			task.spawn(PlayerData.save, player)
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in profiles do
		pending += 1
		task.spawn(function()
			PlayerData.save(player)
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[-- Lógica de las carreras: entrar en mapas, cuenta atrás, checkpoints, meta,
-- caídas, récords y medallas. El servidor mide el tiempo oficial.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Maps = require(script.Parent:WaitForChild("Maps"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local Leaderboard = require(script.Parent:WaitForChild("Leaderboard"))

local RaceService = {}

export type State = {
	mapId: string?,
	mode: string, -- "solo" o "live"
	racing: boolean,
	countdownToken: {}?,
	startTime: number,
	nextCheckpoint: number,
	splits: { number },
	respawnCFrame: CFrame,
	lastStart: number,
	lastRestart: number,
	lastEnter: number,
}

export type Result = {
	mapId: string,
	time: number,
	best: number,
	previousBest: number?,
	isRecord: boolean,
	medal: number,
	previousMedal: number,
	newMedal: boolean,
	splits: { number },
	mode: string,
	rewards: { [string]: any },
}

local states: { [Player]: State } = {}

-- Ganchos para otros módulos
local enterChecks: { (Player, Maps.MapInfo) -> (boolean, string?) } = {}
local finishHandlers: { (Player, Maps.MapInfo, Result) -> () } = {}
local leaveHandlers: { (Player) -> () } = {}

function RaceService.addEnterCheck(check: (Player, Maps.MapInfo) -> (boolean, string?))
	table.insert(enterChecks, check)
end

-- Se llama al terminar, antes de avisar al cliente (puede rellenar result.rewards)
function RaceService.onFinish(handler: (Player, Maps.MapInfo, Result) -> ())
	table.insert(finishHandlers, handler)
end

-- Se llama cuando un jugador sale de su mapa (lobby, otro mapa, desconexión)
function RaceService.onLeaveMap(handler: (Player) -> ())
	table.insert(leaveHandlers, handler)
end

function RaceService.getState(player: Player): State?
	return states[player]
end

-- Cambia entre "solo" y "live" sin mover al jugador (al acabar una carrera en vivo)
function RaceService.setMode(player: Player, mode: string)
	local state = states[player]
	if state then
		state.mode = mode
	end
end

-- Utilidades -----------------------------------------------------------------------

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

function RaceService.teleport(player: Player, cframe: CFrame)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	character:PivotTo(cframe)
	-- Avisa al cliente para que resetee la velocidad
	player:SetAttribute("TeleportTick", ((player:GetAttribute("TeleportTick") :: number?) or 0) + 1)
end

local function setFrozen(player: Player, frozen: boolean)
	player:SetAttribute("Frozen", frozen)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = frozen
	end
end

local function stopRace(player: Player, state: State)
	if state.countdownToken then
		state.countdownToken = nil
		setFrozen(player, false)
	end
	state.racing = false
	state.nextCheckpoint = 1
	table.clear(state.splits)
end

local function currentMap(state: State): Maps.MapInfo?
	return if state.mapId then Maps.get(state.mapId) else nil
end

-- Flujo de la carrera ----------------------------------------------------------------

-- Coloca al jugador en la línea, lo congela y cuenta 3, 2, 1...
function RaceService.beginCountdown(player: Player)
	local state = states[player]
	local map = state and currentMap(state)
	if not state or not map or state.countdownToken then
		return
	end
	local now = os.clock()
	if now - state.lastStart < 0.3 then
		return
	end
	state.lastStart = now

	stopRace(player, state)
	local token = {}
	state.countdownToken = token
	state.respawnCFrame = Maps.startLine(map)

	RaceService.teleport(player, Maps.startLine(map))
	setFrozen(player, true)
	Remotes.RaceCountdown:FireClient(player, map.id, Config.CountdownSeconds)

	task.delay(Config.CountdownSeconds, function()
		if states[player] ~= state or state.countdownToken ~= token then
			return -- cancelada
		end
		state.countdownToken = nil
		setFrozen(player, false)
		state.racing = true
		state.startTime = os.clock()
		state.lastStart = state.startTime
		Remotes.RaceStarted:FireClient(player, map.id, #map.checkpoints, state.mode)
	end)
end

function RaceService.enterMap(player: Player, mapId: string, mode: string?): (boolean, string?)
	local state = states[player]
	local map = Maps.get(mapId)
	if not state or not map then
		return false, "Mapa no encontrado"
	end
	for _, check in enterChecks do
		local ok, message = check(player, map)
		if not ok then
			return false, message
		end
	end
	local now = os.clock()
	if now - state.lastEnter < 1 then
		return false, nil
	end
	state.lastEnter = now

	if state.mapId then
		for _, handler in leaveHandlers do
			handler(player)
		end
	end

	stopRace(player, state)
	state.mapId = map.id
	state.mode = mode or "solo"
	state.lastStart = 0
	state.respawnCFrame = Maps.startLine(map)
	player:SetAttribute("MapId", map.id)

	if state.mode == "solo" then
		RaceService.beginCountdown(player)
	else
		RaceService.teleport(player, Maps.startLine(map))
	end
	return true, nil
end

function RaceService.returnToLobby(player: Player)
	local state = states[player]
	if not state then
		return
	end
	if state.mapId then
		for _, handler in leaveHandlers do
			handler(player)
		end
	end
	stopRace(player, state)
	state.mapId = nil
	state.mode = "solo"
	state.respawnCFrame = Maps.lobbySpawn()
	player:SetAttribute("MapId", nil)
	Remotes.RaceCancelled:FireClient(player, nil)
	RaceService.teleport(player, Maps.lobbySpawn())
end

local function reachCheckpoint(player: Player, map: Maps.MapInfo, index: number)
	local state = states[player]
	if not state or state.mapId ~= map.id or not state.racing or index ~= state.nextCheckpoint then
		return
	end
	local split = os.clock() - state.startTime
	state.nextCheckpoint += 1
	state.splits[index] = split
	state.respawnCFrame = Maps.checkpointCFrame(map.checkpoints[index])

	local data = PlayerData.get(player)
	local mapData = data and data.maps[map.id]
	local bestSplit = mapData and mapData.splits and mapData.splits[index]
	local delta = if typeof(bestSplit) == "number" then split - bestSplit else nil
	Remotes.CheckpointReached:FireClient(player, index, #map.checkpoints, split, delta)
end

local function finishRace(player: Player, map: Maps.MapInfo)
	local state = states[player]
	if not state or state.mapId ~= map.id or not state.racing then
		return
	end
	if state.nextCheckpoint <= #map.checkpoints then
		return -- se ha saltado algún checkpoint
	end

	local elapsed = os.clock() - state.startTime
	local splits = table.clone(state.splits)
	stopRace(player, state)
	state.respawnCFrame = Maps.startLine(map)

	if elapsed < Config.MinValidTime then
		Remotes.RaceCancelled:FireClient(player, "Tiempo no válido")
		return
	end

	local data = PlayerData.get(player)
	local mapData = data and data.maps[map.id] or {}
	local previousBest = mapData.best
	local isRecord = previousBest == nil or elapsed < previousBest
	local oldMedal = mapData.medal or 0
	local medal = if map.tutorial then 0 else Config.MedalRank(elapsed, map.medals)

	if data then
		mapData.runs = (mapData.runs or 0) + 1
		if isRecord then
			mapData.best = elapsed
			mapData.splits = splits
		end
		mapData.medal = math.max(oldMedal, medal)
		data.maps[map.id] = mapData
	end

	local result: Result = {
		mapId = map.id,
		time = elapsed,
		best = if isRecord then elapsed else previousBest,
		previousBest = previousBest,
		isRecord = isRecord,
		medal = medal,
		previousMedal = oldMedal,
		newMedal = medal > oldMedal,
		splits = splits,
		mode = state.mode,
		rewards = {},
	}

	if isRecord and not map.tutorial then
		Leaderboard.submit(player, map.id, elapsed)
	end
	for _, handler in finishHandlers do
		handler(player, map, result)
	end
	if data then
		PlayerData.sync(player)
	end
	Remotes.RaceFinished:FireClient(player, result)

	-- En solitario, vuelve a la salida para otro intento
	if state.mode == "solo" then
		task.delay(3, function()
			if states[player] == state and state.mapId == map.id and not state.racing and not state.countdownToken then
				RaceService.teleport(player, Maps.onTop(map.startPad))
			end
		end)
	end
end

local function restart(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.lastRestart < 0.5 then
		return
	end
	state.lastRestart = now

	if not state.mapId then
		RaceService.teleport(player, Maps.lobbySpawn())
	elseif state.mode == "live" then
		RaceService.teleport(player, state.respawnCFrame) -- en carrera en vivo no se reinicia el tiempo
	else
		RaceService.beginCountdown(player)
	end
end

-- Inicio ---------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local state: State = {
		mapId = nil,
		mode = "solo",
		racing = false,
		countdownToken = nil,
		startTime = 0,
		nextCheckpoint = 1,
		splits = {},
		respawnCFrame = Maps.lobbySpawn(),
		lastStart = 0,
		lastRestart = 0,
		lastEnter = 0,
	}
	states[player] = state

	-- Si muere, reaparece en su último checkpoint (o en la salida si estaba en la cuenta atrás)
	player.CharacterAdded:Connect(function(character)
		if not state.mapId then
			return
		end
		character:WaitForChild("HumanoidRootPart")
		task.wait()
		if state.countdownToken then
			stopRace(player, state)
			Remotes.RaceCancelled:FireClient(player, nil)
			RaceService.teleport(player, Maps.onTop((currentMap(state) :: Maps.MapInfo).startPad))
		else
			RaceService.teleport(player, state.respawnCFrame)
		end
	end)
end

function RaceService.init()
	for _, map in Maps.list() do
		map.startGate.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			local state = player and states[player]
			if
				player
				and state
				and state.mapId == map.id
				and state.mode == "solo"
				and not state.racing
				and not state.countdownToken
			then
				RaceService.beginCountdown(player)
			end
		end)

		map.finish.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player then
				finishRace(player, map)
			end
		end)

		for index, cp in map.checkpoints do
			cp.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if player then
					reachCheckpoint(player, map, index)
				end
			end)
		end
	end

	-- Portales del lobby
	local portals = Maps.lobby():FindFirstChild("Portals")
	if portals then
		for _, portal in portals:GetChildren() do
			local mapId = portal:GetAttribute("MapId")
			if portal:IsA("BasePart") and typeof(mapId) == "string" then
				portal.Touched:Connect(function(hit)
					local player = playerFromHit(hit)
					if player and states[player] and states[player].mapId == nil then
						local ok, message = RaceService.enterMap(player, mapId, "solo")
						if not ok and message then
							Remotes.Notify:FireClient(player, message)
						end
					end
				end)
			end
		end
	end

	Remotes.RequestRestart.OnServerEvent:Connect(restart)
	Remotes.ReturnToLobby.OnServerEvent:Connect(RaceService.returnToLobby)
	Remotes.RequestMap.OnServerInvoke = function(player, mapId)
		if typeof(mapId) ~= "string" then
			return false, "Mapa no válido"
		end
		return RaceService.enterMap(player, mapId, "solo")
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		if states[player] and states[player].mapId then
			for _, handler in leaveHandlers do
				handler(player)
			end
		end
		states[player] = nil
	end)

	-- Caídas al vacío
	task.spawn(function()
		while true do
			for player, state in states do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and not root.Anchored and root.Position.Y < Config.FallY then
					RaceService.teleport(player, state.respawnCFrame)
				end
			end
			task.wait(0.1)
		end
	end)
end

return RaceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[-- Tienda de cosméticos, VIP (Game Pass) y efectos visibles para todos (rastro).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Economy = require(script.Parent:WaitForChild("Economy"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local RaceService = require(script.Parent:WaitForChild("RaceService"))

local Shop = {}

local VIP_COLOR = Color3.fromRGB(255, 205, 40)

function Shop.isVip(player: Player): boolean
	return PlayerData.session(player).vip == true
end

local function canUse(player: Player, data: { [string]: any }, item: Catalog.Item): boolean
	if item.vip then
		return Shop.isVip(player)
	end
	return item.price == 0 or data.owned[item.id] == true
end

-- Objeto equipado de un tipo (o el de por defecto si ya no se puede usar)
local function equippedItem(player: Player, data: { [string]: any }, kind: string): Catalog.Item
	local item = Catalog.byId[data.equipped[kind] or ""]
	if item and item.kind == kind and canUse(player, data, item) then
		return item
	end
	return Catalog.byId[Catalog.Defaults[kind]]
end

-- Rastro en el servidor para que lo vean todos los jugadores
local function applyTrail(player: Player, item: Catalog.Item)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local trail = root:FindFirstChild("CosmeticTrail") :: Trail?
	if not trail then
		local top = Instance.new("Attachment")
		top.Name = "TrailTop"
		top.Position = Vector3.new(0, 0.8, 0.4)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Name = "TrailBottom"
		bottom.Position = Vector3.new(0, -0.8, 0.4)
		bottom.Parent = root

		local newTrail = Instance.new("Trail")
		newTrail.Name = "CosmeticTrail"
		newTrail.Attachment0 = top
		newTrail.Attachment1 = bottom
		newTrail.Lifetime = 0.35
		newTrail.LightEmission = 1
		newTrail.FaceCamera = true
		newTrail.Transparency = NumberSequence.new(0.3, 1)
		newTrail.WidthScale = NumberSequence.new(1, 0)
		newTrail.Enabled = false
		newTrail.Parent = root
		trail = newTrail
	end
	(trail :: Trail).Color = Catalog.colorSequence(item)
end

function Shop.applyCosmetics(player: Player)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	for _, kind in Catalog.Kinds do
		local item = equippedItem(player, data, kind.id)
		player:SetAttribute(kind.id .. "Item", item.id) -- los clientes leen esto para los efectos
		if kind.id == "Trail" then
			applyTrail(player, item)
		end
	end
end

local function checkVip(player: Player)
	local owned = false
	if Config.VipGamePassId ~= 0 then
		local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, Config.VipGamePassId)
		owned = ok and result == true
	end
	PlayerData.session(player).vip = owned
	player:SetAttribute("Vip", owned)
	Shop.applyCosmetics(player)
	PlayerData.sync(player)
end

local function purchase(player: Player, itemId: any): (boolean, string?)
	local data = PlayerData.get(player)
	local item = typeof(itemId) == "string" and Catalog.byId[itemId]
	if not data or not item then
		return false, "Objeto no válido"
	end
	if item.vip then
		return false, "Este objeto es solo para VIP"
	end
	if canUse(player, data, item) then
		return false, "Ya lo tienes"
	end
	if not Economy.spend(player, item.price) then
		return false, "No tienes suficientes monedas"
	end
	data.owned[item.id] = true
	data.equipped[item.kind] = item.id
	Shop.applyCosmetics(player)
	PlayerData.sync(player)
	return true, "¡Comprado y equipado: " .. item.name .. "!"
end

local function equip(player: Player, itemId: any): (boolean, string?)
	local data = PlayerData.get(player)
	local item = typeof(itemId) == "string" and Catalog.byId[itemId]
	if not data or not item then
		return false, "Objeto no válido"
	end
	if not canUse(player, data, item) then
		return false, if item.vip then "Este objeto es solo para VIP" else "Todavía no lo tienes"
	end
	data.equipped[item.kind] = item.id
	Shop.applyCosmetics(player)
	PlayerData.sync(player)
	return true, nil
end

function Shop.init()
	Remotes.Purchase.OnServerInvoke = purchase
	Remotes.Equip.OnServerInvoke = equip

	PlayerData.addSnapshotField(function(player, snapshot)
		snapshot.vip = Shop.isVip(player)
	end)

	PlayerData.onLoaded(function(player)
		checkVip(player)
	end)

	local function onPlayerAdded(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart")
			Shop.applyCosmetics(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.VipGamePassId then
			PlayerData.session(player).vip = true
			player:SetAttribute("Vip", true)
			Shop.applyCosmetics(player)
			PlayerData.sync(player)
			Remotes.Notify:FireClient(player, "⭐ ¡Ya eres VIP! Gracias por tu apoyo", VIP_COLOR)
		end
	end)

	-- Mapas solo para VIP
	RaceService.addEnterCheck(function(player, map)
		if map.vip and not Shop.isVip(player) then
			return false, "⭐ Este mapa es solo para VIP"
		end
		return true, nil
	end)

	-- Enciende el rastro cuando el jugador va rápido
	task.spawn(function()
		while true do
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local trail = root and root:FindFirstChild("CosmeticTrail") :: Trail?
				if root and trail then
					local velocity = root.AssemblyLinearVelocity
					trail.Enabled = Vector3.new(velocity.X, 0, velocity.Z).Magnitude > Config.TrailSpeed
				end
			end
			task.wait(0.15)
		end
	end)
end

return Shop
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="20">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="21">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Character</string>
        </Properties>
        <Item class="LocalScript" referent="23">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Efectos visuales y de sonido del movimiento: poses, partículas de salto y
-- deslizamiento, viento, sonidos y temblor de cámara al caer fuerte.
-- Lee el estado que publica Movement (atributos ParkourState, WallSide, WallJumpTick)
-- y los cosméticos equipados (atributos JumpItem y SlideItem del jugador).
-- Nota: estos efectos son locales, solo los ve el propio jugador. El rastro lo
-- pone el servidor (Shop) para que lo vea todo el mundo.

local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Config = require(Shared:WaitForChild("Config"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local character = script:FindFirstAncestorOfClass("Model") :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart
local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

local ClientState = require(player:WaitForChild("PlayerScripts"):WaitForChild("Client"):WaitForChild("ClientState"))

local function equipped(kind: string): Catalog.Item
	return Catalog.byId[player:GetAttribute(kind .. "Item") or ""] or Catalog.byId[Catalog.Defaults[kind]]
end

local SHAKE_STEP = "ParkourCameraShake"

local function horizontalSpeed(): number
	local v = root.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

-- Poses (inclinamos la articulación raíz; funciona con R15 y R6) ----------------

local lowerTorso = character:FindFirstChild("LowerTorso")
local rootJoint = (
	if lowerTorso then lowerTorso:WaitForChild("Root", 5) else root:WaitForChild("RootJoint", 5)
) :: Motor6D?
local baseC0 = if rootJoint then rootJoint.C0 else CFrame.identity
local poseOffset = CFrame.identity

local function targetPose(state: string?): CFrame
	if state == "Slide" then
		-- Cuerpo bajo e inclinado hacia atrás
		return CFrame.new(0, -1.3, 0) * CFrame.Angles(math.rad(Config.SlidePoseLean), 0, 0)
	elseif state == "WallRun" then
		local side = character:GetAttribute("WallSide") or 1
		return CFrame.Angles(0, 0, -math.rad(Config.WallRunPoseLean) * side)
	end
	return CFrame.identity
end

-- Partículas al deslizar y al saltar ----------------------------------------------

local feet = Instance.new("Attachment")
feet.Name = "SlideDust"
feet.Position = Vector3.new(0, -(humanoid.HipHeight + root.Size.Y / 2) + 0.3, 0)
feet.Parent = root

local dust = Instance.new("ParticleEmitter")
dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
dust.EmissionDirection = Enum.NormalId.Back
dust.Rate = 40
dust.Lifetime = NumberRange.new(0.3, 0.6)
dust.Speed = NumberRange.new(4, 8)
dust.SpreadAngle = Vector2.new(35, 35)
dust.Size = NumberSequence.new(0.6, 1.8)
dust.Transparency = NumberSequence.new(0.4, 1)
dust.Color = Catalog.colorSequence(equipped("Slide"))
dust.Enabled = false
dust.Parent = feet

local jumpBurst = Instance.new("ParticleEmitter")
jumpBurst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
jumpBurst.EmissionDirection = Enum.NormalId.Bottom
jumpBurst.Rate = 0
jumpBurst.Lifetime = NumberRange.new(0.3, 0.6)
jumpBurst.Speed = NumberRange.new(6, 12)
jumpBurst.SpreadAngle = Vector2.new(70, 70)
jumpBurst.Size = NumberSequence.new(0.5, 0)
jumpBurst.LightEmission = 0.6
jumpBurst.Parent = feet

local function updateCosmetics()
	dust.Color = Catalog.colorSequence(equipped("Slide"))
	jumpBurst.Color = Catalog.colorSequence(equipped("Jump"))
end
updateCosmetics()
local slideItemConnection = player:GetAttributeChangedSignal("SlideItem"):Connect(updateCosmetics)
local jumpItemConnection = player:GetAttributeChangedSignal("JumpItem"):Connect(updateCosmetics)

-- Viento según la velocidad ------------------------------------------------------

local wind = Sfx.create("Wind", 0)
if wind then
	wind.Looped = true
	wind:Play()
end

-- Temblor de cámara ---------------------------------------------------------------

local SHAKE_DURATION = 0.35
local shakeTime = 0
local shakeStrength = 0

local function shake(strength: number)
	if not ClientState.setting("shake") then
		return
	end
	shakeStrength = math.max(if shakeTime > 0 then shakeStrength else 0, strength)
	shakeTime = SHAKE_DURATION
end

pcall(RunService.UnbindFromRenderStep, RunService, SHAKE_STEP)
RunService:BindToRenderStep(SHAKE_STEP, Enum.RenderPriority.Camera.Value + 2, function(dt)
	if shakeTime <= 0 then
		return
	end
	shakeTime -= dt
	local amount = shakeStrength * math.max(shakeTime, 0) / SHAKE_DURATION * 0.05
	camera.CFrame *= CFrame.Angles((math.random() - 0.5) * amount, (math.random() - 0.5) * amount, 0)
end)

-- Aterrizajes fuertes -------------------------------------------------------------

local peakFallSpeed = 0

humanoid.StateChanged:Connect(function(_, newState)
	if newState == Enum.HumanoidStateType.Jumping and equipped("Jump").id ~= Catalog.Defaults.Jump then
		jumpBurst:Emit(25)
	end
	if newState == Enum.HumanoidStateType.Landed then
		if peakFallSpeed > Config.HardLandingSpeed then
			local strength = math.clamp((peakFallSpeed - Config.HardLandingSpeed) / 80, 0.3, 1)
			shake(strength)
			Sfx.play("Land", 1, 0.4 + 0.4 * strength)
		end
		peakFallSpeed = 0
	end
end)

-- Sonidos de acciones -------------------------------------------------------------

character:GetAttributeChangedSignal("ParkourState"):Connect(function()
	if character:GetAttribute("ParkourState") == "Slide" then
		Sfx.play("Slide", 1.1, 0.5)
	end
end)

character:GetAttributeChangedSignal("WallJumpTick"):Connect(function()
	Sfx.play("WallJump", 1.3, 0.6)
end)

-- Bucle principal ------------------------------------------------------------------

local connection = RunService.Heartbeat:Connect(function(dt)
	local state = character:GetAttribute("ParkourState")
	local speed = horizontalSpeed()
	local airborne = humanoid.FloorMaterial == Enum.Material.Air

	-- Pose
	if rootJoint then
		poseOffset = poseOffset:Lerp(targetPose(state), math.min(dt * 12, 1))
		rootJoint.C0 = poseOffset * baseC0
	end

	dust.Enabled = state == "Slide" and not airborne

	if airborne then
		peakFallSpeed = math.max(peakFallSpeed, -root.AssemblyLinearVelocity.Y)
	end

	if wind then
		local alpha = math.clamp(
			(speed - Config.BaseWalkSpeed) / (Config.WallRunSpeed - Config.BaseWalkSpeed),
			0,
			1
		)
		wind.Volume = if ClientState.setting("wind") then 0.5 * alpha else 0
		wind.PlaybackSpeed = 0.8 + 0.4 * alpha
	end
end)

local function cleanup()
	connection:Disconnect()
	slideItemConnection:Disconnect()
	jumpItemConnection:Disconnect()
	pcall(RunService.UnbindFromRenderStep, RunService, SHAKE_STEP)
	if wind then
		wind:Destroy()
		wind = nil
	end
end

humanoid.Died:Connect(cleanup)
character.Destroying:Connect(cleanup)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="24">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[-- Movimiento de parkour: momentum al correr, deslizamiento, wall run y wall jump.
-- Va en StarterCharacterScripts, así que se reinicia con cada personaje.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local ClientState = require(player:WaitForChild("PlayerScripts"):WaitForChild("Client"):WaitForChild("ClientState"))
local character = script:FindFirstAncestorOfClass("Model") :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart
local camera = workspace.CurrentCamera

local CAMERA_STEP = "ParkourCameraTilt"
local SLIDE_ACTION = "ParkourSlide"

humanoid.UseJumpPower = true
humanoid.JumpPower = Config.JumpPower
humanoid.WalkSpeed = Config.BaseWalkSpeed

-- Fuerza que usamos para pegarnos a la pared durante el wall run
local attachment = Instance.new("Attachment")
attachment.Name = "ParkourAttachment"
attachment.Parent = root

local wallVelocity = Instance.new("LinearVelocity")
wallVelocity.Attachment0 = attachment
wallVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
wallVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
wallVelocity.MaxForce = math.huge
wallVelocity.Enabled = false
wallVelocity.Parent = root

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = { character }

-- Estado
local currentSpeed = Config.BaseWalkSpeed
local slideEndTime = 0
local lastSlideTime = -math.huge
local wallRunning = false
local wallNormal = Vector3.zero
local wallTangent = Vector3.zero
local wallRunStart = 0
local lastWallRunEnd = -math.huge
local lastWall: Instance? = nil
local cameraTilt = 0

-- Estado visible para el script de efectos (Effects): "None", "Slide" o "WallRun"
local function setParkourState(name: string)
	if character:GetAttribute("ParkourState") ~= name then
		character:SetAttribute("ParkourState", name)
	end
end

local function isGrounded(): boolean
	return humanoid.FloorMaterial ~= Enum.Material.Air
end

local function horizontalSpeed(): number
	local v = root.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

-- Deslizamiento ------------------------------------------------------------

local function trySlide()
	local now = os.clock()
	if now < slideEndTime or now - lastSlideTime < Config.SlideCooldown then
		return
	end
	if not isGrounded() or humanoid.MoveDirection.Magnitude < 0.1 then
		return
	end
	lastSlideTime = now
	slideEndTime = now + Config.SlideDuration
	-- El deslizamiento también deja buena parte del momentum ganado
	currentSpeed = math.max(currentSpeed, Config.BaseWalkSpeed + (Config.MaxWalkSpeed - Config.BaseWalkSpeed) * 0.75)
	humanoid.CameraOffset = Vector3.new(0, -1.5, 0)
end

ContextActionService:BindAction(SLIDE_ACTION, function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		trySlide()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
ContextActionService:SetTitle(SLIDE_ACTION, "Deslizar")
ContextActionService:SetPosition(SLIDE_ACTION, UDim2.new(1, -170, 1, -110))

-- En móvil, botón de deslizar más grande y cerca del de saltar
local slideButton = ContextActionService:GetButton(SLIDE_ACTION)
if slideButton then
	slideButton.Size = UDim2.fromOffset(90, 90)
	slideButton.Position = UDim2.new(1, -220, 1, -130)
	local title = slideButton:FindFirstChild("ActionTitle")
	if title and title:IsA("TextLabel") then
		title.TextScaled = true
	end
end

-- Wall run -----------------------------------------------------------------

local function findWall(): RaycastResult?
	local right = root.CFrame.RightVector
	for _, side in { 1, -1 } do
		local result = workspace:Raycast(root.Position, right * side * Config.WallRunCheckDistance, rayParams)
		if result and math.abs(result.Normal.Y) < 0.2 then
			return result
		end
	end
	return nil
end

local function stopWallRun()
	if not wallRunning then
		return
	end
	wallRunning = false
	wallVelocity.Enabled = false
	lastWallRunEnd = os.clock()
end

local function tryStartWallRun()
	local now = os.clock()
	if wallRunning or isGrounded() or now - lastWallRunEnd < Config.WallRunCooldown then
		return
	end
	if humanoid.MoveDirection.Magnitude < 0.1 or horizontalSpeed() < Config.WallRunMinSpeed then
		return
	end

	local hit = findWall()
	if not hit then
		return
	end
	-- No volver a engancharse a la misma pared justo después de saltar de ella
	if hit.Instance == lastWall and now - lastWallRunEnd < 0.6 then
		return
	end

	local tangent = hit.Normal:Cross(Vector3.yAxis).Unit
	if tangent:Dot(root.CFrame.LookVector) < 0 then
		tangent = -tangent
	end

	wallRunning = true
	-- 1 = pared a la derecha, -1 = pared a la izquierda
	character:SetAttribute("WallSide", if hit.Normal:Dot(root.CFrame.RightVector) < 0 then 1 else -1)
	wallNormal = hit.Normal
	wallTangent = tangent
	wallRunStart = now
	lastWall = hit.Instance
	wallVelocity.Enabled = true
end

local function updateWallRun()
	local elapsed = os.clock() - wallRunStart
	local stillOnWall = workspace:Raycast(root.Position, -wallNormal * (Config.WallRunCheckDistance + 1), rayParams)

	if
		not stillOnWall
		or elapsed > Config.WallRunMaxTime
		or isGrounded()
		or humanoid.MoveDirection.Magnitude < 0.1
	then
		stopWallRun()
		return
	end

	local fall = Config.WallRunFallSpeed + elapsed * 8
	wallVelocity.VectorVelocity = wallTangent * Config.WallRunSpeed - wallNormal * 1 - Vector3.new(0, fall, 0)
end

-- Salto desde la pared
UserInputService.JumpRequest:Connect(function()
	if not wallRunning then
		return
	end
	stopWallRun()
	root.AssemblyLinearVelocity = wallNormal * Config.WallJumpOutForce
		+ Vector3.new(0, Config.WallJumpUpForce, 0)
		+ wallTangent * Config.WallRunSpeed * 0.8
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	character:SetAttribute("WallJumpTick", (character:GetAttribute("WallJumpTick") or 0) + 1)
end)

-- Bucle principal ------------------------------------------------------------

local connection = RunService.Heartbeat:Connect(function(dt)
	-- Congelado durante la cuenta atrás
	if player:GetAttribute("Frozen") then
		stopWallRun()
		slideEndTime = 0
		currentSpeed = Config.BaseWalkSpeed
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.CameraOffset = Vector3.zero
		setParkourState("None")
		return
	end
	humanoid.JumpPower = Config.JumpPower

	-- En la tirolina manda el script de obstáculos
	if character:GetAttribute("Riding") then
		stopWallRun()
		setParkourState("None")
		return
	end

	local now = os.clock()
	local moving = humanoid.MoveDirection.Magnitude > 0.1

	-- Momentum: acelera corriendo en el suelo, se pierde al pararse
	if not moving then
		currentSpeed = Config.BaseWalkSpeed
	elseif isGrounded() then
		currentSpeed = math.min(currentSpeed + Config.Acceleration * dt, Config.MaxWalkSpeed)
	end

	if wallRunning then
		updateWallRun()
	else
		tryStartWallRun()
	end

	-- Velocidad final según la acción actual
	if wallRunning then
		humanoid.WalkSpeed = Config.WallRunSpeed
		setParkourState("WallRun")
	elseif now < slideEndTime then
		local remaining = (slideEndTime - now) / Config.SlideDuration
		humanoid.WalkSpeed = currentSpeed + Config.SlideBoost * remaining
		setParkourState("Slide")
	else
		humanoid.WalkSpeed = currentSpeed
		setParkourState("None")
		if humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
		end
	end

	-- FOV según la velocidad
	local speedAlpha = math.clamp(
		(horizontalSpeed() - Config.BaseWalkSpeed) / (Config.WallRunSpeed - Config.BaseWalkSpeed),
		0,
		1
	)
	local targetFov = if ClientState.setting("fov")
		then Config.BaseFOV + (Config.MaxFOV - Config.BaseFOV) * speedAlpha
		else Config.BaseFOV
	camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(dt * 6, 1)
end)

-- Inclinar la cámara durante el wall run (después de que la cámara se actualice)
pcall(RunService.UnbindFromRenderStep, RunService, CAMERA_STEP)
RunService:BindToRenderStep(CAMERA_STEP, Enum.RenderPriority.Camera.Value + 1, function(dt)
	local target = 0
	if wallRunning then
		local side = if wallNormal:Dot(camera.CFrame.RightVector) > 0 then 1 else -1
		target = math.rad(Config.WallRunCameraTilt) * side
	end
	cameraTilt += (target - cameraTilt) * math.min(dt * 10, 1)
	if math.abs(cameraTilt) > 0.001 then
		camera.CFrame *= CFrame.Angles(0, 0, cameraTilt)
	end
end)

-- Cuando el servidor nos teletransporta (checkpoint / reinicio), perdemos la velocidad
local teleportConnection = player:GetAttributeChangedSignal("TeleportTick"):Connect(function()
	stopWallRun()
	slideEndTime = 0
	currentSpeed = Config.BaseWalkSpeed
	root.AssemblyLinearVelocity = Vector3.zero
end)

local function cleanup()
	connection:Disconnect()
	teleportConnection:Disconnect()
	pcall(RunService.UnbindFromRenderStep, RunService, CAMERA_STEP)
	ContextActionService:UnbindAction(SLIDE_ACTION)
	camera.FieldOfView = Config.BaseFOV
end

humanoid.Died:Connect(cleanup)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="25">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[-- Datos del jugador en el cliente (los envía el servidor con DataSync).
-- También lo usan los scripts del personaje para leer los ajustes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = {
	data = nil :: { [string]: any }?,
}

local changed = Instance.new("BindableEvent")
ClientState.Changed = changed.Event

Remotes.DataSync.OnClientEvent:Connect(function(snapshot)
	ClientState.data = snapshot
	changed:Fire()
end)
Remotes.DataSync:FireServer() -- pide los datos por si ya se enviaron antes de cargar

function ClientState.mapData(mapId: string): { [string]: any }?
	local data = ClientState.data
	return data and data.maps[mapId]
end

-- Ajustes del jugador (con valor por defecto si aún no han llegado los datos)
function ClientState.setting(key: string): boolean
	local data = ClientState.data
	local value = data and data.settings and data.settings[key]
	if value == nil then
		return Config.DefaultSettings[key] ~= false
	end
	return value == true
end

-- Cambia un ajuste: se aplica al momento y se guarda en el servidor
function ClientState.setSetting(key: string, value: boolean)
	local data = ClientState.data
	if data then
		data.settings[key] = value
	end
	changed:Fire()
	Remotes.UpdateSetting:FireServer(key, value)
end

-- Carpeta de un mapa en Workspace (con sus atributos: nombre, medallas...)
function ClientState.mapFolder(mapId: string): Folder?
	local maps = workspace:FindFirstChild("Maps")
	return maps and maps:FindFirstChild(mapId) :: Folder?
end

function ClientState.mapsSorted(): { Folder }
	local maps = workspace:WaitForChild("Maps")
	local list = {}
	for _, folder in maps:GetChildren() do
		if folder:IsA("Folder") then
			table.insert(list, folder)
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Order") or 0) < (b:GetAttribute("Order") or 0)
	end)
	return list
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Ghost</string>
            <string name="Source"><![CDATA[-- Modo fantasma: graba tu carrera y, en el siguiente intento, muestra una
-- silueta de tu mejor intento corriendo a tu lado.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))

local player = Players.LocalPlayer

local Ghost = {}

type Sample = { position: Vector3, yaw: number }

local ghosts: { [string]: { Sample }? } = {} -- mejor intento por mapa

local recording: { Sample }? = nil
local recordStart = 0

local playback: { samples: { Sample }, model: Model, start: number }? = nil

-- Formato: "x,y,z,yaw;x,y,z,yaw;..."
local function encode(samples: { Sample }): string
	local parts = table.create(#samples)
	for i, sample in samples do
		local p = sample.position
		parts[i] = string.format("%.1f,%.1f,%.1f,%.2f", p.X, p.Y, p.Z, sample.yaw)
	end
	return table.concat(parts, ";")
end

local function decode(encoded: string): { Sample }
	local samples = {}
	for _, chunk in string.split(encoded, ";") do
		local values = string.split(chunk, ",")
		local x, y, z, yaw = tonumber(values[1]), tonumber(values[2]), tonumber(values[3]), tonumber(values[4])
		if x and y and z and yaw then
			table.insert(samples, { position = Vector3.new(x, y, z), yaw = yaw })
		end
	end
	return samples
end

local function getRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Copia translúcida de tu personaje, sin scripts ni colisiones
local function makeModel(): Model?
	local character = player.Character
	if not character then
		return nil
	end
	local archivable = character.Archivable
	character.Archivable = true
	local clone = character:Clone()
	character.Archivable = archivable
	if not clone then
		return nil
	end

	for _, descendant in clone:GetDescendants() do
		if
			descendant:IsA("LuaSourceContainer")
			or descendant:IsA("Sound")
			or descendant:IsA("ParticleEmitter")
			or descendant:IsA("Trail")
			or descendant:IsA("Constraint")
			or descendant:IsA("BillboardGui")
			or descendant:IsA("Clothing")
		then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
			descendant.Color = Config.GhostColor
			descendant.Material = Enum.Material.ForceField
			descendant.Transparency = if descendant.Name == "HumanoidRootPart" then 1 else 0.2
		elseif descendant:IsA("Decal") then
			descendant.Transparency = 1
		end
	end
	-- Sin Humanoid: si lo tiene, Roblox vuelve a activar la colisión del torso y la cabeza
	local humanoid = clone:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Destroy()
	end
	clone.Name = "Ghost"
	clone.Parent = workspace
	return clone
end

local function stopPlayback()
	if playback then
		playback.model:Destroy()
		playback = nil
	end
end

local function startPlayback(mapId: string)
	stopPlayback()
	local samples = ghosts[mapId]
	if not samples or #samples < 2 or not ClientState.setting("ghost") then
		return
	end
	local model = makeModel()
	if model then
		playback = { samples = samples, model = model, start = os.clock() }
	end
end

local function update()
	local now = os.clock()

	if recording then
		local index = math.floor((now - recordStart) / Config.GhostSampleInterval) + 1
		local root = getRoot()
		-- Si bajan los FPS, repetimos la muestra para no desincronizar el tiempo
		while root and #recording < index and #recording < Config.GhostMaxSamples do
			local look = root.CFrame.LookVector
			table.insert(recording, { position = root.Position, yaw = math.atan2(-look.X, -look.Z) })
		end
	end

	if playback then
		local samples = playback.samples
		local t = (now - playback.start) / Config.GhostSampleInterval + 1
		local i = math.clamp(math.floor(t), 1, #samples - 1)
		local alpha = math.clamp(t - i, 0, 1)
		local a, b = samples[i], samples[i + 1]
		local position = a.position:Lerp(b.position, alpha)
		local turn = (b.yaw - a.yaw + math.pi) % (2 * math.pi) - math.pi -- giro más corto
		local yaw = a.yaw + turn * alpha
		playback.model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
		if t > #samples + 10 then
			stopPlayback() -- 1 segundo después de llegar a la meta
		end
	end
end

function Ghost.start()
	Remotes.GhostData.OnClientEvent:Connect(function(mapId: string, encoded: string?)
		ghosts[mapId] = if encoded then decode(encoded) else nil
	end)

	Remotes.RaceCountdown.OnClientEvent:Connect(function()
		recording = nil
		stopPlayback()
	end)

	Remotes.RaceStarted.OnClientEvent:Connect(function(mapId: string)
		recording = {}
		recordStart = os.clock()
		startPlayback(mapId)
	end)

	Remotes.RaceFinished.OnClientEvent:Connect(function(result)
		local samples = recording
		recording = nil
		if result.isRecord and samples and #samples > 1 then
			local root = getRoot()
			if root then
				local look = root.CFrame.LookVector
				table.insert(samples, { position = root.Position, yaw = math.atan2(-look.X, -look.Z) })
			end
			ghosts[result.mapId] = samples
			Remotes.SubmitGhost:FireServer(result.mapId, encode(samples))
		end
	end)

	Remotes.RaceCancelled.OnClientEvent:Connect(function()
		recording = nil
		stopPlayback()
	end)

	ClientState.Changed:Connect(function()
		if not ClientState.setting("ghost") then
			stopPlayback()
		end
	end)

	RunService.Heartbeat:Connect(update)
end

return Ghost
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- Interfaz de la carrera: cronómetro, parciales, medallas, cuenta atrás,
-- mensajes y botones laterales (Mapas, Lobby...).

local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local HUD = {}

local gui: ScreenGui
local racePanel: Frame
local timerLabel: TextLabel
local checkpointLabel: TextLabel
local deltaLabel: TextLabel
local mapLabel: TextLabel
local popupLabel: TextLabel
local subPopupLabel: TextLabel
local countdownLabel: TextLabel
local countdownScale: UIScale
local controlsLabel: TextLabel
local sideBar: Frame
local levelLabel: TextLabel
local xpFill: Frame
local coinsLabel: TextLabel

local running = false
local startTime = 0
local countdownToken: {}? = nil

-- Mensajes emergentes ----------------------------------------------------------------

local popupTweens: { Tween } = {}

function HUD.popup(text: string, color: Color3?, subtext: string?)
	for _, tween in popupTweens do
		tween:Cancel()
	end
	table.clear(popupTweens)

	popupLabel.Text = text
	popupLabel.TextColor3 = color or UI.Colors.Text
	subPopupLabel.Text = subtext or ""
	for _, label in { popupLabel, subPopupLabel } do
		label.TextTransparency = 0
		label.TextStrokeTransparency = 0.4
		local tween = TweenService:Create(
			label,
			TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2),
			{ TextTransparency = 1, TextStrokeTransparency = 1 }
		)
		tween:Play()
		table.insert(popupTweens, tween)
	end
end

-- Botones laterales (otros módulos añaden los suyos) -----------------------------------

function HUD.addSideButton(text: string, order: number, color: Color3?, callback: () -> ()): TextButton
	local button = UI.button(sideBar, text, color or UI.Colors.Card, {
		Size = UDim2.fromOffset(170, 48),
		LayoutOrder = order,
	})
	button.Activated:Connect(callback)
	return button
end

-- Información del mapa actual ----------------------------------------------------------

local function updateStats()
	local data = ClientState.data
	if not data then
		return
	end
	local level, current, needed = Config.LevelFromXP(data.xp)
	levelLabel.Text = string.format("Nivel %d", level) .. (if data.vip then "  ⭐ VIP" else "")
	xpFill.Size = UDim2.fromScale(math.clamp(current / needed, 0, 1), 1)
	coinsLabel.Text = string.format("🪙 %d", data.coins)
end

local function nextMedalText(mapId: string): string
	local folder = ClientState.mapFolder(mapId)
	if not folder or folder:GetAttribute("Tutorial") then
		return ""
	end
	local mapData = ClientState.mapData(mapId)
	local current = mapData and mapData.medal or 0
	if current >= #Config.Medals then
		return "  ·  ¡Todas las medallas!"
	end
	local nextMedal = Config.MedalInfo(current + 1)
	local seconds = folder:GetAttribute(nextMedal.id)
	return string.format("  ·  %s: %s", nextMedal.name, Config.FormatTime(seconds))
end

local function updateMapInfo()
	local mapId = player:GetAttribute("MapId")
	if typeof(mapId) ~= "string" then
		racePanel.Visible = false
		return
	end
	racePanel.Visible = true
	local folder = ClientState.mapFolder(mapId)
	local mapData = ClientState.mapData(mapId)
	local name = folder and folder:GetAttribute("DisplayName") or mapId
	mapLabel.Text = string.format(
		"%s  ·  Mejor: %s%s",
		name,
		Config.FormatTime(mapData and mapData.best),
		nextMedalText(mapId)
	)
end

-- Confeti al batir un récord
local function confetti()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local emitter = UI.new("ParticleEmitter", {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 210, 0)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 255, 140)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 170, 255)),
		}),
		EmissionDirection = Enum.NormalId.Top,
		Speed = NumberRange.new(20, 35),
		SpreadAngle = Vector2.new(60, 60),
		Lifetime = NumberRange.new(1, 2),
		Acceleration = Vector3.new(0, -30, 0),
		Size = NumberSequence.new(0.6, 0.2),
		LightEmission = 0.5,
		Rate = 0,
	}, root)
	emitter:Emit(80)
	Debris:AddItem(emitter, 3)
end

-- Cuenta atrás -------------------------------------------------------------------------

local function bumpCountdown(text: string, color: Color3)
	countdownLabel.Visible = true
	countdownLabel.Text = text
	countdownLabel.TextColor3 = color
	countdownScale.Scale = 1.6
	TweenService:Create(countdownScale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local function hideCountdown()
	countdownToken = nil
	countdownLabel.Visible = false
end

local function resetTimer(text: string)
	running = false
	timerLabel.Text = Config.FormatTime(0)
	timerLabel.TextColor3 = UI.Colors.Text
	checkpointLabel.Text = text
	deltaLabel.Text = ""
end

local function formatDelta(delta: number): (string, Color3)
	if delta <= 0 then
		return string.format("-%.3f", -delta), UI.Colors.Good
	end
	return string.format("+%.3f", delta), UI.Colors.Bad
end

-- Construcción -------------------------------------------------------------------------

local function build()
	gui = UI.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	HUD.gui = gui

	racePanel = UI.new("Frame", {
		Name = "Race",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 44),
		Size = UDim2.fromOffset(520, 150),
		BackgroundTransparency = 1,
		Visible = false,
	}, gui)
	UI.autoScale(racePanel, 0.7)

	timerLabel = UI.label(racePanel, {
		Size = UDim2.new(1, 0, 0, 60),
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0.5,
		Text = Config.FormatTime(0),
	})
	deltaLabel = UI.label(racePanel, {
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 0, 26),
		TextStrokeTransparency = 0.5,
		Text = "",
	})
	checkpointLabel = UI.label(racePanel, {
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.new(1, 0, 0, 26),
		TextStrokeTransparency = 0.5,
		Text = "",
	})
	mapLabel = UI.label(racePanel, {
		Position = UDim2.fromOffset(0, 118),
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = UI.Colors.Gold,
		TextStrokeTransparency = 0.5,
		Text = "",
	})

	popupLabel = UI.label(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.33),
		Size = UDim2.new(0.8, 0, 0, 64),
		Font = Enum.Font.GothamBlack,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Text = "",
	})
	UI.new("UITextSizeConstraint", { MaxTextSize = 56 }, popupLabel)
	subPopupLabel = UI.label(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.33, 50),
		Size = UDim2.new(0.8, 0, 0, 30),
		TextColor3 = UI.Colors.Gold,
		TextTransparency = 1,
		TextStrokeTransparency = 1,
		Text = "",
	})
	UI.new("UITextSizeConstraint", { MaxTextSize = 28 }, subPopupLabel)

	countdownLabel = UI.label(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(260, 160),
		Font = Enum.Font.GothamBlack,
		TextStrokeTransparency = 0.3,
		Visible = false,
		Text = "",
	})
	countdownScale = UI.new("UIScale", nil, countdownLabel)

	local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	controlsLabel = UI.label(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(420, 70),
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTransparency = 0.2,
		TextStrokeTransparency = 0.6,
		Text = if isTouch
			then "Botón Deslizar: más velocidad\nSalta hacia una pared: wall run\nSalta en la pared: wall jump"
			else "Corre para ganar velocidad  ·  C / Ctrl: deslizar\nSalta hacia una pared: wall run  ·  Espacio en la pared: wall jump\nR: reiniciar",
		Visible = not isTouch,
	})
	UI.new("UITextSizeConstraint", { MaxTextSize = 18 }, controlsLabel)

	-- Nivel, XP y monedas (arriba a la izquierda)
	local stats = UI.new("Frame", {
		Name = "Stats",
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.fromOffset(220, 84),
		BackgroundColor3 = UI.Colors.Background,
		BackgroundTransparency = 0.3,
	}, gui)
	UI.corner(stats, 10)
	UI.autoScale(stats, 0.6)
	levelLabel = UI.label(stats, {
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 26),
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Nivel 1",
	})
	local xpBar = UI.new("Frame", {
		Position = UDim2.fromOffset(12, 36),
		Size = UDim2.new(1, -24, 0, 10),
		BackgroundColor3 = UI.Colors.Card,
	}, stats)
	UI.corner(xpBar, 5)
	xpFill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = UI.Colors.Good,
	}, xpBar)
	UI.corner(xpFill, 5)
	coinsLabel = UI.label(stats, {
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UI.Colors.Gold,
		Text = "🪙 0",
	})

	UI.label(gui, {
		Name = "Version",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -4),
		Size = UDim2.fromOffset(120, 16),
		Font = Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTransparency = 0.5,
		Text = "v" .. Config.Version,
	})

	sideBar = UI.new("Frame", {
		Name = "SideBar",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.45, 0),
		Size = UDim2.fromOffset(170, 300),
		BackgroundTransparency = 1,
	}, gui)
	UI.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, sideBar)
	UI.autoScale(sideBar, 0.6)
end

-- En móvil, los botones de ContextActionService son pequeños: los agrandamos
function HUD.enlargeTouchButton(actionName: string, position: UDim2)
	local button = ContextActionService:GetButton(actionName)
	if button then
		button.Size = UDim2.fromOffset(80, 80)
		button.Position = position
		local title = button:FindFirstChild("ActionTitle")
		if title and title:IsA("TextLabel") then
			title.TextScaled = true
		end
	end
end

function HUD.setControlsVisible(visible: boolean)
	local isTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	controlsLabel.Visible = visible and not isTouch
end

function HUD.start()
	build()

	RunService.RenderStepped:Connect(function()
		if running then
			timerLabel.Text = Config.FormatTime(os.clock() - startTime)
		end
	end)

	player:GetAttributeChangedSignal("MapId"):Connect(updateMapInfo)
	ClientState.Changed:Connect(updateMapInfo)
	ClientState.Changed:Connect(updateStats)
	ClientState.Changed:Connect(function()
		HUD.setControlsVisible(ClientState.setting("hints"))
	end)
	updateMapInfo()
	updateStats()

	HUD.addSideButton("🏠 Lobby", 90, nil, function()
		Remotes.ReturnToLobby:FireServer()
	end)

	Remotes.RaceCountdown.OnClientEvent:Connect(function(_mapId: string, seconds: number)
		resetTimer("¡Prepárate!")
		local token = {}
		countdownToken = token
		for i = seconds, 1, -1 do
			if countdownToken ~= token then
				return
			end
			bumpCountdown(tostring(i), UI.Colors.Text)
			Sfx.play("Countdown", 0.8)
			task.wait(1)
		end
	end)

	Remotes.RaceStarted.OnClientEvent:Connect(function(_mapId: string, total: number)
		-- "¡YA!" llega del servidor, así el tiempo empieza a la vez en los dos lados
		local token = {}
		countdownToken = token
		bumpCountdown("¡YA!", UI.Colors.Good)
		Sfx.play("Go", 1.4, 0.8)
		task.delay(0.8, function()
			if countdownToken == token then
				hideCountdown()
			end
		end)
		running = true
		startTime = os.clock()
		checkpointLabel.Text = string.format("Checkpoint 0/%d", total)
		deltaLabel.Text = ""
	end)

	Remotes.CheckpointReached.OnClientEvent:Connect(function(index: number, total: number, split: number, delta: number?)
		checkpointLabel.Text = string.format("Checkpoint %d/%d", index, total)
		local subtext = nil
		if delta then
			local text, color = formatDelta(delta)
			deltaLabel.Text = text
			deltaLabel.TextColor3 = color
			subtext = text .. " respecto a tu récord"
		end
		HUD.popup(string.format("Checkpoint %d  ·  %s", index, Config.FormatTime(split)), UI.Colors.Good, subtext)
		Sfx.play("Checkpoint", 1.2)
	end)

	Remotes.RaceFinished.OnClientEvent:Connect(function(result)
		running = false
		timerLabel.Text = Config.FormatTime(result.time) -- tiempo oficial del servidor
		checkpointLabel.Text = "¡Meta!"

		local parts = {}
		if result.rewards.place then
			table.insert(parts, string.format("Puesto %dº en la carrera en vivo", result.rewards.place))
		end
		if result.newMedal then
			local medal = Config.MedalInfo(result.medal)
			table.insert(parts, "¡Medalla de " .. medal.name .. "!")
		end
		if result.rewards.coins and result.rewards.coins > 0 then
			table.insert(parts, string.format("+%d monedas", result.rewards.coins))
		end
		if result.rewards.xp and result.rewards.xp > 0 then
			table.insert(parts, string.format("+%d XP", result.rewards.xp))
		end
		if result.rewards.levelUp then
			table.insert(parts, string.format("¡Nivel %d!", result.rewards.levelUp))
		end
		local subtext = table.concat(parts, "   ")

		if result.isRecord then
			timerLabel.TextColor3 = UI.Colors.Gold
			HUD.popup("¡NUEVO RÉCORD!  " .. Config.FormatTime(result.time), UI.Colors.Gold, subtext)
			Sfx.play("Record", 1, 0.8)
			confetti()
		else
			local text, color = formatDelta(result.time - result.best)
			deltaLabel.Text = text
			deltaLabel.TextColor3 = color
			HUD.popup(string.format("%s  (%s)", Config.FormatTime(result.time), text), UI.Colors.Bad, subtext)
			Sfx.play("Finish", 1, 0.5)
		end
		if result.newMedal then
			Sfx.play("Medal", 1.6, 0.7)
		end
	end)

	Remotes.RaceCancelled.OnClientEvent:Connect(function(reason: string?)
		hideCountdown()
		resetTimer("Cruza la salida azul para empezar")
		if reason then
			HUD.popup(reason, UI.Colors.Bad)
		end
	end)

	Remotes.Notify.OnClientEvent:Connect(function(text: string, color: Color3?)
		HUD.popup(text, color or UI.Colors.Text)
	end)

	-- Reiniciar
	ContextActionService:BindAction("ParkourRestart", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Remotes.RequestRestart:FireServer()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("ParkourRestart", "Reiniciar")
	ContextActionService:SetPosition("ParkourRestart", UDim2.new(1, -200, 1, -210))
	HUD.enlargeTouchButton("ParkourRestart", UDim2.new(1, -200, 1, -230))
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">LiveRaceUI</string>
            <string name="Source"><![CDATA[-- Interfaz de la carrera en vivo: banner con el estado y botón para unirse.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local HUD = require(script.Parent:WaitForChild("HUD"))
local MapMenu = require(script.Parent:WaitForChild("MapMenu"))
local UI = require(script.Parent:WaitForChild("UI"))

local LiveRaceUI = {}

local PURPLE = Color3.fromRGB(150, 70, 255)
local PLACES = { "1º", "2º", "3º" }

local banner: Frame
local bannerLabel: TextLabel
local joinButton: TextButton
local inQueue = false

local function setQueued(join: boolean)
	local ok, message = Remotes.SetLiveRaceQueue:InvokeServer(join)
	if message then
		HUD.popup(message, if ok then PURPLE else UI.Colors.Bad)
	end
end

local function standings(results: { { name: string, time: number } }, limit: number): string
	local parts = {}
	for i = 1, math.min(limit, #results) do
		local entry = results[i]
		table.insert(parts, string.format("%s %s %s", PLACES[i] or (i .. "º"), entry.name, Config.FormatTime(entry.time)))
	end
	return table.concat(parts, "   ·   ")
end

local function onUpdate(status: { [string]: any })
	local phase = status.phase
	inQueue = phase ~= "none" and phase ~= "results"
	joinButton.Text = if inQueue then "🏁 Salir de la carrera" else "🏁 Carrera en vivo"
	banner.Visible = phase ~= "none"

	if phase == "waiting" then
		bannerLabel.Text = string.format("🏁 Carrera en vivo · Esperando jugadores (%d/%d)", status.queued, status.needed)
	elseif phase == "intermission" then
		bannerLabel.Text = string.format("🏁 La carrera empieza en %d s · %d jugadores", status.timeLeft, status.queued)
	elseif phase == "racing" then
		local text = string.format("🏁 %s · Quedan %d s", status.map or "", status.timeLeft)
		if #status.results > 0 then
			text ..= "   ·   " .. standings(status.results, 3)
		end
		bannerLabel.Text = text
	elseif phase == "results" then
		bannerLabel.Text = "🏁 Resultados: " .. (if #status.results > 0 then standings(status.results, 3) else "nadie terminó")
		HUD.popup("¡Carrera terminada!", PURPLE, standings(status.results, 3))
		task.delay(8, function()
			if not inQueue then
				banner.Visible = false
			end
		end)
	end
end

function LiveRaceUI.start()
	banner = UI.new("Frame", {
		Name = "LiveRace",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(760, 34),
		BackgroundColor3 = PURPLE,
		BackgroundTransparency = 0.25,
		Visible = false,
	}, HUD.gui)
	UI.corner(banner, 8)
	UI.autoScale(banner, 0.5)

	bannerLabel = UI.label(banner, {
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 1, -8),
		Text = "",
	})

	joinButton = MapMenu.addHeaderButton("🏁 Carrera en vivo", 2, PURPLE, function()
		setQueued(not inQueue)
	end)

	Remotes.LiveRaceUpdate.OnClientEvent:Connect(onUpdate)
end

return LiveRaceUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="31">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Arranque del cliente: pone en marcha la interfaz y los sistemas locales.

local Client = script.Parent

local HUD = require(Client:WaitForChild("HUD"))
local MapMenu = require(Client:WaitForChild("MapMenu"))
local LiveRaceUI = require(Client:WaitForChild("LiveRaceUI"))
local ShopMenu = require(Client:WaitForChild("ShopMenu"))
local SettingsMenu = require(Client:WaitForChild("SettingsMenu"))
local RankingsMenu = require(Client:WaitForChild("RankingsMenu"))
local StartMenu = require(Client:WaitForChild("StartMenu"))
local Obstacles = require(Client:WaitForChild("Obstacles"))
local Ghost = require(Client:WaitForChild("Ghost"))

HUD.start()
MapMenu.start()
LiveRaceUI.start()
ShopMenu.start()
RankingsMenu.start()
SettingsMenu.start()
StartMenu.start()
Obstacles.start()
Ghost.start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">MapMenu</string>
            <string name="Source"><![CDATA[-- Selector de mapas: tu mejor tiempo, medallas conseguidas y tiempos objetivo.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local UI = require(script.Parent:WaitForChild("UI"))

local MapMenu = {}

local PANEL = "Maps"

local list: ScrollingFrame
local header: Frame

local function medalRow(parent: Instance, folder: Folder, earned: number)
	local row = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 82),
		Size = UDim2.new(1, -170, 0, 24),
	}, parent)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, row)
	for rank = 1, #Config.Medals do
		local medal = Config.MedalInfo(rank)
		local seconds = folder:GetAttribute(medal.id)
		if seconds then
			UI.label(row, {
				Size = UDim2.fromOffset(110, 24),
				LayoutOrder = rank,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = medal.color,
				TextTransparency = if earned >= rank then 0 else 0.55,
				Text = (if earned >= rank then "● " else "○ ") .. string.format("%.1fs", seconds),
			})
		end
	end
end

local function play(mapId: string)
	local ok, message = Remotes.RequestMap:InvokeServer(mapId)
	if ok then
		UI.close(PANEL)
	elseif message then
		HUD.popup(message, UI.Colors.Bad)
	end
end

-- Otros módulos pueden personalizar las tarjetas (por ejemplo, bloquear mapas VIP).
-- Si el decorador devuelve una función, sustituye a la acción del botón JUGAR.
type Decorator = (Frame, Folder, TextButton) -> (() -> ())?
local cardDecorators: { Decorator } = {}

function MapMenu.decorateCards(decorator: Decorator)
	table.insert(cardDecorators, decorator)
end

-- Fila superior para botones extra (tutorial, carrera en vivo...)
function MapMenu.addHeaderButton(text: string, order: number, color: Color3, callback: () -> ()): TextButton
	local button = UI.button(header, text, color, {
		Size = UDim2.fromOffset(250, 44),
		LayoutOrder = order,
	})
	button.Activated:Connect(callback)
	return button
end

function MapMenu.refresh()
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for i, folder in ClientState.mapsSorted() do
		if folder:GetAttribute("Tutorial") then
			continue
		end
		local color = folder:GetAttribute("Color") or UI.Colors.Accent
		local mapData = ClientState.mapData(folder.Name)
		local earned = mapData and mapData.medal or 0

		local card = UI.new("Frame", {
			Name = folder.Name,
			Size = UDim2.new(1, -12, 0, 118),
			BackgroundColor3 = UI.Colors.Card,
			LayoutOrder = i,
		}, list)
		UI.corner(card, 12)
		UI.new("Frame", {
			Size = UDim2.new(0, 8, 1, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}, card)

		UI.label(card, {
			Position = UDim2.fromOffset(16, 10),
			Size = UDim2.new(1, -180, 0, 36),
			Font = Enum.Font.GothamBlack,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = folder:GetAttribute("DisplayName") or folder.Name,
		})
		UI.label(card, {
			Name = "Best",
			Position = UDim2.fromOffset(16, 50),
			Size = UDim2.new(1, -180, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = UI.Colors.Muted,
			Text = string.format(
				"Mejor: %s   ·   Medalla: %s",
				Config.FormatTime(mapData and mapData.best),
				if earned > 0 then Config.MedalInfo(earned).name else "ninguna"
			),
		})
		medalRow(card, folder, earned)

		local playButton = UI.button(card, "JUGAR", UI.Colors.Good, {
			Name = "Play",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(140, 56),
		})
		local action = function()
			play(folder.Name)
		end
		for _, decorate in cardDecorators do
			action = decorate(card, folder, playButton) or action
		end
		playButton.Activated:Connect(function()
			action()
		end)
	end
end

function MapMenu.start()
	local frame, content = UI.panel(HUD.gui, PANEL, "🗺  Mapas", UDim2.fromOffset(720, 560))

	header = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
	}, content)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, header)

	list = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -54),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, content)
	UI.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, list)

	MapMenu.addHeaderButton("📘 Tutorial", 1, UI.Colors.Good, function()
		play("tutorial")
	end)

	UI.onOpen(PANEL, MapMenu.refresh)
	ClientState.Changed:Connect(function()
		if frame.Visible then
			MapMenu.refresh()
		end
	end)

	HUD.addSideButton("🗺 Mapas", 10, UI.Colors.Accent, function()
		UI.toggle(PANEL)
	end)
end

return MapMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Obstacles</string>
            <string name="Source"><![CDATA[-- Obstáculos especiales (los simula cada cliente para que vayan suaves):
--   MovingPlatform: se mueve con el tiempo del servidor y te lleva encima
--   Trampoline: te lanza hacia arriba
--   Zipline: salta hacia el cable para engancharte; Espacio para soltarte
--   LowGravity: dentro de la zona la gravedad es menor
--   Spinner: modelo decorativo que gira y flota (atributo SpinSpeed en grados/s)

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local player = Players.LocalPlayer

local Obstacles = {}

-- Personaje actual
local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local gravityForce: VectorForce? = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Plataformas móviles ------------------------------------------------------------------

type Platform = { base: CFrame, offset: Vector3, period: number, phase: number }
local platforms: { [BasePart]: Platform } = {}

local function addPlatform(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	platforms[part] = {
		base = part.CFrame,
		offset = part:GetAttribute("Offset") or Vector3.zero,
		period = part:GetAttribute("Period") or 3,
		phase = part:GetAttribute("Phase") or 0,
	}
end

local function updatePlatforms()
	local now = workspace:GetServerTimeNow()
	local standingOn: Instance? = nil
	if root and humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), rayParams)
		standingOn = hit and hit.Instance
	end

	for part, platform in platforms do
		local alpha = math.sin((now / platform.period + platform.phase) * math.pi * 2)
		local target = platform.base + platform.offset * alpha
		local delta = target.Position - part.Position
		part.CFrame = target
		if part == standingOn and root then
			root.CFrame += delta -- te lleva con ella
		end
	end
end

-- Trampolines --------------------------------------------------------------------------

local lastBounce = 0

local function addTrampoline(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	part.Touched:Connect(function(hit)
		if not character or not root or not humanoid or not hit:IsDescendantOf(character) then
			return
		end
		local now = os.clock()
		if now - lastBounce < 0.3 then
			return
		end
		lastBounce = now
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, part:GetAttribute("Power") or Config.TrampolinePower, velocity.Z)
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		Sfx.play("Bounce", 0.8, 0.6)
	end)
end

-- Tirolinas ------------------------------------------------------------------------------

type Zipline = { a: Vector3, b: Vector3, direction: Vector3, length: number }
local ziplines: { [BasePart]: Zipline } = {}

type Ride = { zipline: Zipline, distance: number, speed: number }
local riding: Ride? = nil
local rideCooldown = 0

local HANG_OFFSET = Vector3.new(0, 3.5, 0) -- las manos están por encima del centro del personaje

local function addZipline(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	local a = part:GetAttribute("A")
	local b = part:GetAttribute("B")
	if typeof(a) ~= "Vector3" or typeof(b) ~= "Vector3" then
		return
	end
	ziplines[part] = { a = a, b = b, direction = (b - a).Unit, length = (b - a).Magnitude }
end

local function stopRide(jump: boolean)
	local ride = riding
	if not ride then
		return
	end
	riding = nil
	rideCooldown = os.clock() + 0.5
	if character then
		character:SetAttribute("Riding", false)
	end
	if humanoid and root then
		humanoid.PlatformStand = false
		local up = if jump then Config.JumpPower * 0.8 else 0
		root.AssemblyLinearVelocity = ride.zipline.direction * ride.speed + Vector3.new(0, up, 0)
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end
end

local function tryGrab()
	if not root or not humanoid or humanoid.FloorMaterial ~= Enum.Material.Air or os.clock() < rideCooldown then
		return
	end
	local hands = root.Position + HANG_OFFSET
	for _, zipline in ziplines do
		local t = math.clamp((hands - zipline.a):Dot(zipline.direction), 0, zipline.length)
		if t < zipline.length * 0.85 then
			local closest = zipline.a + zipline.direction * t
			if (hands - closest).Magnitude < Config.ZiplineGrabDistance then
				local velocity = root.AssemblyLinearVelocity
				riding = {
					zipline = zipline,
					distance = t,
					speed = math.max(Vector3.new(velocity.X, 0, velocity.Z).Magnitude, Config.ZiplineMinSpeed),
				}
				humanoid.PlatformStand = true
				if character then
					character:SetAttribute("Riding", true)
				end
				return
			end
		end
	end
end

local function updateRide(dt: number)
	local ride = riding
	if not ride or not root then
		return
	end
	local zipline = ride.zipline
	-- Acelera con la pendiente
	local slope = -zipline.direction.Y
	ride.speed = math.min(ride.speed + (workspace.Gravity * slope + 8) * dt, Config.ZiplineMaxSpeed)
	ride.distance += ride.speed * dt
	if ride.distance >= zipline.length then
		stopRide(false)
		return
	end
	local point = zipline.a + zipline.direction * ride.distance - HANG_OFFSET
	local flat = Vector3.new(zipline.direction.X, 0, zipline.direction.Z)
	root.CFrame = CFrame.lookAt(point, point + flat)
	root.AssemblyLinearVelocity = zipline.direction * ride.speed
end

-- Gravedad baja ----------------------------------------------------------------------------

local zones: { BasePart } = {}

local function addZone(part: Instance)
	if part:IsA("BasePart") then
		table.insert(zones, part)
	end
end

local function updateGravity()
	if not root or not gravityForce then
		return
	end
	local factor = 1
	for _, zone in zones do
		local relative = zone.CFrame:PointToObjectSpace(root.Position)
		local half = zone.Size / 2
		if math.abs(relative.X) <= half.X and math.abs(relative.Y) <= half.Y and math.abs(relative.Z) <= half.Z then
			factor = math.min(factor, zone:GetAttribute("Gravity") or Config.LowGravityFactor)
		end
	end
	if factor < 1 then
		gravityForce.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity * (1 - factor), 0)
		gravityForce.Enabled = true
	else
		gravityForce.Enabled = false
	end
end

-- Decoración que gira ------------------------------------------------------------------------

local spinners: { [Model]: { base: CFrame, speed: number } } = {}

local function addSpinner(model: Instance)
	if model:IsA("Model") then
		spinners[model] = { base = model:GetPivot(), speed = model:GetAttribute("SpinSpeed") or 30 }
	end
end

local function updateSpinners()
	local now = workspace:GetServerTimeNow()
	for model, spinner in spinners do
		if not model.Parent then
			spinners[model] = nil
			continue
		end
		local angle = math.rad(now * spinner.speed)
		local bob = math.sin(now * 1.5) * 0.6
		model:PivotTo(spinner.base * CFrame.new(0, bob, 0) * CFrame.Angles(angle * 0.3, angle, 0))
	end
end

-- Inicio ---------------------------------------------------------------------------------

local function onCharacter(newCharacter: Model)
	riding = nil
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid") :: Humanoid
	root = newCharacter:WaitForChild("HumanoidRootPart") :: BasePart
	rayParams.FilterDescendantsInstances = { newCharacter }

	local attachment = Instance.new("Attachment")
	attachment.Name = "GravityAttachment"
	attachment.Parent = root
	local force = Instance.new("VectorForce")
	force.Attachment0 = attachment
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Enabled = false
	force.Parent = root
	gravityForce = force
end

local function watchTag(tag: string, callback: (Instance) -> ())
	for _, instance in CollectionService:GetTagged(tag) do
		callback(instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(callback)
end

function Obstacles.start()
	watchTag("MovingPlatform", addPlatform)
	watchTag("Trampoline", addTrampoline)
	watchTag("Zipline", addZipline)
	watchTag("LowGravity", addZone)
	watchTag("Spinner", addSpinner)
	RunService.RenderStepped:Connect(updateSpinners)

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	-- Al teletransportarte (checkpoint, reinicio) te sueltas de la tirolina
	player:GetAttributeChangedSignal("TeleportTick"):Connect(function()
		if riding then
			riding = nil
			rideCooldown = os.clock() + 0.5
			if humanoid then
				humanoid.PlatformStand = false
			end
			if character then
				character:SetAttribute("Riding", false)
			end
		end
	end)

	UserInputService.JumpRequest:Connect(function()
		if riding then
			stopRide(true)
		end
	end)

	RunService.PreSimulation:Connect(function(dt)
		if humanoid and humanoid.Health <= 0 then
			return
		end
		updatePlatforms()
		if riding then
			updateRide(dt)
		else
			tryGrab()
		end
		updateGravity()
	end)
end

return Obstacles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">RankingsMenu</string>
            <string name="Source"><![CDATA[-- Panel de rankings: top de cada mapa (histórico y semanal) desde cualquier sitio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local RankingsMenu = {}

local PANEL = "Rankings"
local PERIODS = { { id = "all", name = "Histórico" }, { id = "week", name = "Esta semana" } }

local tabs: Frame
local columns: { [string]: Frame } = {}
local currentMap: string? = nil
local requestId = 0

local function fillColumn(column: Frame, entries: { { name: string, seconds: number } })
	for _, child in column:GetChildren() do
		if child:IsA("TextLabel") and child.Name == "Row" then
			child:Destroy()
		end
	end
	if #entries == 0 then
		UI.label(column, {
			Name = "Row",
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 1,
			TextColor3 = UI.Colors.Muted,
			Text = "Aún no hay tiempos",
		})
		return
	end
	for rank, entry in entries do
		local isMe = entry.name == player.Name
		UI.label(column, {
			Name = "Row",
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = rank,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = if isMe then UI.Colors.Gold elseif rank <= 3 then UI.Colors.Text else UI.Colors.Muted,
			Text = string.format("%d. %s   %s", rank, entry.name, Config.FormatTime(entry.seconds)),
		})
	end
end

local function showMap(mapId: string)
	currentMap = mapId
	for _, button in tabs:GetChildren() do
		if button:IsA("TextButton") then
			button.BackgroundColor3 = if button.Name == mapId then UI.Colors.Accent else UI.Colors.Card
		end
	end

	requestId += 1
	local myRequest = requestId
	for _, column in columns do
		fillColumn(column, {})
	end
	local data = Remotes.GetLeaderboard:InvokeServer(mapId)
	if myRequest ~= requestId or not data then
		return -- el jugador ya cambió de mapa
	end
	for _, period in PERIODS do
		fillColumn(columns[period.id], data[period.id] or {})
	end
end

local function buildTabs()
	for _, child in tabs:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local first = nil
	for i, folder in ClientState.mapsSorted() do
		if folder:GetAttribute("Tutorial") then
			continue
		end
		first = first or folder.Name
		local button = UI.button(tabs, folder:GetAttribute("DisplayName") or folder.Name, UI.Colors.Card, {
			Name = folder.Name,
			Size = UDim2.fromOffset(150, 40),
			LayoutOrder = i,
		})
		button.Activated:Connect(function()
			showMap(folder.Name)
		end)
	end
	return first
end

function RankingsMenu.start()
	local _, content = UI.panel(HUD.gui, PANEL, "🏆  Rankings", UDim2.fromOffset(720, 520))

	tabs = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
	}, content)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, tabs)

	for i, period in PERIODS do
		local column = UI.new("Frame", {
			Position = UDim2.new((i - 1) / 2, if i == 1 then 0 else 8, 0, 54),
			Size = UDim2.new(0.5, -8, 1, -54),
			BackgroundColor3 = UI.Colors.Card,
		}, content)
		UI.corner(column, 10)
		UI.padding(column, 12)
		UI.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}, column)
		UI.label(column, {
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = 0,
			Font = Enum.Font.GothamBlack,
			TextColor3 = UI.Colors.Gold,
			Text = period.name,
		})
		columns[period.id] = column
	end

	UI.onOpen(PANEL, function()
		local first = buildTabs()
		local target = player:GetAttribute("MapId")
		if typeof(target) ~= "string" or not tabs:FindFirstChild(target) then
			target = currentMap or first
		end
		if target then
			task.spawn(showMap, target)
		end
	end)

	HUD.addSideButton("🏆 Rankings", 15, nil, function()
		UI.toggle(PANEL)
	end)
end

return RankingsMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">SettingsMenu</string>
            <string name="Source"><![CDATA[-- Ajustes del jugador (se guardan en su cuenta).

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local UI = require(script.Parent:WaitForChild("UI"))

local SettingsMenu = {}

local PANEL = "Settings"

local OPTIONS = {
	{ key = "shake", name = "Temblor de cámara al caer" },
	{ key = "fov", name = "Efecto de velocidad en la cámara" },
	{ key = "ghost", name = "Mostrar fantasma (tu mejor intento)" },
	{ key = "wind", name = "Sonido de viento" },
	{ key = "hints", name = "Mostrar controles en pantalla" },
}

local toggles: { [string]: TextButton } = {}

local function refresh()
	for key, button in toggles do
		local on = ClientState.setting(key)
		button.Text = if on then "SÍ" else "NO"
		button.BackgroundColor3 = if on then UI.Colors.Good else UI.Colors.Card
	end
end

function SettingsMenu.start()
	local frame, content = UI.panel(HUD.gui, PANEL, "⚙  Ajustes", UDim2.fromOffset(560, 470))

	UI.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, content)

	for i, option in OPTIONS do
		local row = UI.new("Frame", {
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundColor3 = UI.Colors.Card,
			LayoutOrder = i,
		}, content)
		UI.corner(row, 10)
		UI.label(row, {
			Position = UDim2.fromOffset(16, 12),
			Size = UDim2.new(1, -140, 0, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = option.name,
		})
		local toggle = UI.button(row, "SÍ", UI.Colors.Good, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(100, 38),
		})
		toggle.Activated:Connect(function()
			ClientState.setSetting(option.key, not ClientState.setting(option.key))
		end)
		toggles[option.key] = toggle
	end

	UI.label(content, {
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 100,
		Font = Enum.Font.Gotham,
		TextColor3 = UI.Colors.Muted,
		TextWrapped = true,
		Text = "La sensibilidad de la cámara y el volumen se cambian en el menú de Roblox (tecla Esc).",
	})

	UI.onOpen(PANEL, refresh)
	ClientState.Changed:Connect(function()
		if frame.Visible then
			refresh()
		end
	end)

	HUD.addSideButton("⚙ Ajustes", 30, nil, function()
		UI.toggle(PANEL)
	end)
end

return SettingsMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ShopMenu</string>
            <string name="Source"><![CDATA[-- Tienda: rastros, efectos de salto y de deslizamiento, y el pase VIP.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared:WaitForChild("Catalog"))
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local MapMenu = require(script.Parent:WaitForChild("MapMenu"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local ShopMenu = {}

local PANEL = "Shop"

local currentKind = "Trail"
local grid: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local vipButton: TextButton
local panelFrame: Frame

function ShopMenu.promptVip()
	if Config.VipGamePassId == 0 then
		HUD.popup("El pase VIP aún no está configurado", UI.Colors.Bad, "Pon el ID del Game Pass en Config.VipGamePassId")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, Config.VipGamePassId)
end

local function itemState(item: Catalog.Item): string
	local data = ClientState.data
	if not data then
		return "locked"
	end
	local equipped = data.equipped[item.kind] or Catalog.Defaults[item.kind]
	if equipped == item.id then
		return "equipped"
	end
	if item.vip then
		return if data.vip then "owned" else "vip"
	end
	if item.price == 0 or data.owned[item.id] then
		return "owned"
	end
	return if data.coins >= item.price then "buy" else "expensive"
end

local function onItemClicked(item: Catalog.Item, state: string)
	if state == "vip" then
		ShopMenu.promptVip()
		return
	end
	local remote = if state == "buy" then Remotes.Purchase elseif state == "owned" then Remotes.Equip else nil
	if not remote then
		if state == "expensive" then
			HUD.popup("No tienes suficientes monedas", UI.Colors.Bad)
		end
		return
	end
	local ok, message = remote:InvokeServer(item.id)
	if message then
		HUD.popup(message, if ok then UI.Colors.Good else UI.Colors.Bad)
	end
end

local function refresh()
	for kind, button in tabButtons do
		button.BackgroundColor3 = if kind == currentKind then UI.Colors.Accent else UI.Colors.Card
	end
	local data = ClientState.data
	vipButton.Text = if data and data.vip then "⭐ Eres VIP" else "⭐ Hazte VIP"

	for _, child in grid:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for i, item in Catalog.Items do
		if item.kind ~= currentKind then
			continue
		end
		local state = itemState(item)
		local card = UI.new("Frame", {
			Name = item.id,
			BackgroundColor3 = UI.Colors.Card,
			LayoutOrder = i,
		}, grid)
		UI.corner(card, 10)

		local preview = UI.new("Frame", {
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.new(1, -20, 0, 50),
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, card)
		UI.corner(preview, 8)
		UI.new("UIGradient", { Color = Catalog.colorSequence(item) }, preview)

		UI.label(card, {
			Position = UDim2.fromOffset(10, 66),
			Size = UDim2.new(1, -20, 0, 24),
			Text = (if item.vip then "⭐ " else "") .. item.name,
		})

		local text, color
		if state == "equipped" then
			text, color = "Equipado", UI.Colors.Good
		elseif state == "owned" then
			text, color = "Equipar", UI.Colors.Accent
		elseif state == "vip" then
			text, color = "Solo VIP", UI.Colors.Gold
		elseif state == "buy" then
			text, color = string.format("🪙 %d", item.price), UI.Colors.Gold
		else
			text, color = string.format("🪙 %d", item.price), UI.Colors.Muted
		end
		local button = UI.button(card, text, color, {
			Position = UDim2.new(0, 10, 1, -46),
			Size = UDim2.new(1, -20, 0, 36),
			TextColor3 = if state == "buy" or state == "vip" then UI.Colors.Background else UI.Colors.Text,
		})
		button.Activated:Connect(function()
			onItemClicked(item, state)
		end)
	end
end

function ShopMenu.start()
	local frame, content = UI.panel(HUD.gui, PANEL, "🛒  Tienda", UDim2.fromOffset(720, 560))
	panelFrame = frame

	local tabs = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
	}, content)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 10),
	}, tabs)
	for i, kind in Catalog.Kinds do
		local button = UI.button(tabs, kind.name, UI.Colors.Card, {
			Size = UDim2.fromOffset(150, 44),
			LayoutOrder = i,
		})
		button.Activated:Connect(function()
			currentKind = kind.id
			refresh()
		end)
		tabButtons[kind.id] = button
	end
	vipButton = UI.button(tabs, "⭐ Hazte VIP", UI.Colors.Gold, {
		Size = UDim2.fromOffset(170, 44),
		LayoutOrder = 10,
		TextColor3 = UI.Colors.Background,
	})
	vipButton.Activated:Connect(function()
		local data = ClientState.data
		if data and data.vip then
			HUD.popup("VIP: mapa Cielo, objetos exclusivos y +50% de monedas", UI.Colors.Gold)
		else
			ShopMenu.promptVip()
		end
	end)

	grid = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -54),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, content)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, 150),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)

	UI.onOpen(PANEL, refresh)
	ClientState.Changed:Connect(function()
		if panelFrame.Visible then
			refresh()
		end
	end)

	HUD.addSideButton("🛒 Tienda", 20, UI.Colors.Gold, function()
		UI.toggle(PANEL)
	end)

	-- Mapas VIP bloqueados en el selector
	MapMenu.decorateCards(function(_card, folder, playButton)
		local data = ClientState.data
		if folder:GetAttribute("Vip") and not (data and data.vip) then
			playButton.Text = "⭐ VIP"
			playButton.BackgroundColor3 = UI.Colors.Gold
			playButton.TextColor3 = UI.Colors.Background
			return ShopMenu.promptVip
		end
		return nil
	end)
end

return ShopMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">StartMenu</string>
            <string name="Source"><![CDATA[-- Menú de inicio: aparece al entrar al juego.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent:WaitForChild("ClientState"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local UI = require(script.Parent:WaitForChild("UI"))

local player = Players.LocalPlayer

local StartMenu = {}

local gui: ScreenGui
local tutorialButton: TextButton
local tutorialHint: TextLabel

local function close()
	local background = gui:FindFirstChild("Background") :: Frame
	TweenService:Create(background, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
	for _, descendant in background:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.Visible = false
		end
	end
	task.delay(0.3, function()
		gui.Enabled = false
	end)
end

local function updateTutorialHint()
	local data = ClientState.data
	local recommended = data ~= nil and not data.tutorialDone
	tutorialHint.Visible = recommended
	tutorialButton.BackgroundColor3 = if recommended then UI.Colors.Good else UI.Colors.Card
end

function StartMenu.start()
	gui = UI.new("ScreenGui", {
		Name = "StartMenu",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
	}, player:WaitForChild("PlayerGui"))

	local background = UI.new("Frame", {
		Name = "Background",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UI.Colors.Background,
		BackgroundTransparency = 0.15,
	}, gui)
	UI.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(0, 60, 110), Color3.fromRGB(60, 0, 90)),
		Rotation = 45,
	}, background)

	local column = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, 460),
		BackgroundTransparency = 1,
	}, background)
	UI.autoScale(column, 0.6)

	UI.label(column, {
		Size = UDim2.new(1, 0, 0, 90),
		Font = Enum.Font.GothamBlack,
		Text = "PARKOUR DE VELOCIDAD",
		TextStrokeTransparency = 0.5,
	})
	UI.label(column, {
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Enum.Font.Gotham,
		TextColor3 = UI.Colors.Muted,
		Text = "Corre, desliza y salta por las paredes. Bate tu récord.",
	})

	local playButton = UI.button(column, "JUGAR", UI.Colors.Accent, {
		Position = UDim2.fromOffset(60, 160),
		Size = UDim2.new(1, -120, 0, 70),
	})
	playButton.Activated:Connect(close)

	tutorialButton = UI.button(column, "TUTORIAL", UI.Colors.Card, {
		Position = UDim2.fromOffset(60, 250),
		Size = UDim2.new(1, -120, 0, 60),
	})
	tutorialButton.Activated:Connect(function()
		close()
		local ok, message = Remotes.RequestMap:InvokeServer("tutorial")
		if not ok and message then
			HUD.popup(message, UI.Colors.Bad)
		end
	end)
	tutorialHint = UI.label(column, {
		Position = UDim2.fromOffset(60, 312),
		Size = UDim2.new(1, -120, 0, 22),
		TextColor3 = UI.Colors.Good,
		Text = "¡Recomendado si es tu primera vez!",
		Visible = false,
	})

	local settingsButton = UI.button(column, "AJUSTES", UI.Colors.Card, {
		Position = UDim2.fromOffset(60, 350),
		Size = UDim2.new(1, -120, 0, 60),
	})
	settingsButton.Activated:Connect(function()
		close()
		UI.open("Settings")
	end)

	UI.label(background, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -12),
		Size = UDim2.fromOffset(200, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = UI.Colors.Muted,
		Text = "Versión " .. Config.Version,
	})

	updateTutorialHint()
	ClientState.Changed:Connect(updateTutorialHint)
end

return StartMenu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Pequeña librería para crear la interfaz con un estilo común.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Colors = {
	Background = Color3.fromRGB(18, 20, 30),
	Panel = Color3.fromRGB(28, 31, 45),
	Card = Color3.fromRGB(38, 42, 60),
	Accent = Color3.fromRGB(0, 170, 255),
	Text = Color3.new(1, 1, 1),
	Muted = Color3.fromRGB(160, 165, 190),
	Good = Color3.fromRGB(0, 230, 120),
	Bad = Color3.fromRGB(255, 90, 90),
	Gold = Color3.fromRGB(255, 205, 40),
}

function UI.new(className: string, props: { [string]: any }?, parent: Instance?): any
	local instance = Instance.new(className)
	for key, value in (props or {}) :: { [string]: any } do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

function UI.corner(parent: Instance, radius: number?)
	UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

function UI.padding(parent: Instance, pixels: number)
	local p = UDim.new(0, pixels)
	UI.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p }, parent)
end

function UI.label(parent: Instance, props: { [string]: any }): TextLabel
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
	}, nil)
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

function UI.button(parent: Instance, text: string, color: Color3?, props: { [string]: any }?): TextButton
	local button = UI.new("TextButton", {
		BackgroundColor3 = color or UI.Colors.Accent,
		Font = Enum.Font.GothamBlack,
		TextColor3 = UI.Colors.Text,
		TextScaled = true,
		Text = text,
		AutoButtonColor = true,
	}, nil)
	for key, value in (props or {}) :: { [string]: any } do
		(button :: any)[key] = value
	end
	UI.corner(button, 8)
	UI.new("UITextSizeConstraint", { MaxTextSize = 28 }, button)
	button.Parent = parent
	return button
end

-- Escala un elemento según el tamaño de la pantalla (móviles más pequeño)
function UI.autoScale(guiObject: GuiObject, minScale: number?)
	local scale = UI.new("UIScale", nil, guiObject)
	local camera = workspace.CurrentCamera
	local function update()
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1100, size.Y / 650), minScale or 0.55, 1)
	end
	update()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
end

-- Paneles: solo uno abierto a la vez -----------------------------------------------

local panels: { [string]: { frame: GuiObject, onOpen: (() -> ())? } } = {}
local openName: string? = nil

function UI.panel(gui: ScreenGui, name: string, title: string, size: UDim2): (Frame, Frame)
	local frame = UI.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = UI.Colors.Panel,
		Visible = false,
	}, gui)
	UI.corner(frame, 14)
	UI.new("UIStroke", { Color = UI.Colors.Accent, Thickness = 2, Transparency = 0.4 }, frame)
	UI.autoScale(frame)

	UI.label(frame, {
		Name = "Title",
		Size = UDim2.new(1, -120, 0, 40),
		Position = UDim2.fromOffset(20, 14),
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
	})

	local close = UI.button(frame, "X", UI.Colors.Bad, {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(40, 40),
	})
	close.Activated:Connect(function()
		UI.close(name)
	end)

	local content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 66),
		Size = UDim2.new(1, -40, 1, -86),
	}, frame)

	panels[name] = { frame = frame }
	return frame, content
end

function UI.onOpen(name: string, callback: () -> ())
	panels[name].onOpen = callback
end

function UI.open(name: string)
	for other, panel in panels do
		panel.frame.Visible = other == name
	end
	openName = name
	local panel = panels[name]
	if panel.onOpen then
		panel.onOpen()
	end
	local scale = panel.frame:FindFirstChildOfClass("UIScale")
	if scale then
		local target = scale.Scale
		scale.Scale = target * 0.9
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = target }):Play()
	end
end

function UI.close(name: string?)
	local target = name or openName
	if target and panels[target] then
		panels[target].frame.Visible = false
	end
	if target == openName then
		openName = nil
	end
end

function UI.toggle(name: string)
	if openName == name then
		UI.close(name)
	else
		UI.open(name)
	end
end

function UI.isOpen(name: string): boolean
	return openName == name
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
