      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CourseBuilder</string>
          <string name="Source"><![CDATA[-- Genera un circuito de prueba si en Workspace no hay una carpeta "Course".
-- Puedes construir tu propio mapa en Studio con la misma estructura:
--   Course/Spawn          (SpawnLocation)
--   Course/Start          (Part que inicia el tiempo al tocarla)
--   Course/Finish         (Part que para el tiempo)
--   Course/Checkpoints/*  (Parts con el atributo "Index" = 1, 2, 3...)
--   Course/KillParts/*    (opcional: Parts que te devuelven al checkpoint)
--   Course/Leaderboard    (opcional: Part donde se muestra el ranking)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local CourseBuilder = {}

local COLORS = {
	Platform = Color3.fromRGB(230, 232, 240),
	Runway = Color3.fromRGB(60, 64, 80),
	Wall = Color3.fromRGB(255, 120, 40),
	Start = Color3.fromRGB(0, 170, 255),
	Checkpoint = Color3.fromRGB(0, 255, 140),
	Finish = Color3.fromRGB(255, 210, 0),
	Board = Color3.fromRGB(25, 25, 35),
}

local function newPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local part = Instance.new(className) :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

function CourseBuilder.build(): Folder
	-- Desactiva otros spawns (p. ej. el de la plantilla Baseplate) para aparecer siempre en la salida
	for _, descendant in workspace:GetDescendants() do
		if descendant:IsA("SpawnLocation") then
			descendant.Enabled = false
		end
	end

	local course = Instance.new("Folder")
	course.Name = "Course"

	local checkpointsFolder = Instance.new("Folder")
	checkpointsFolder.Name = "Checkpoints"
	checkpointsFolder.Parent = course

	local baseY = Config.CourseHeight
	local cursor = 0 -- distancia recorrida hacia -Z (hacia donde mira el jugador al aparecer)
	local checkpointCount = 0

	-- Plataforma que empieza en el cursor y avanza "length" studs
	local function block(length: number, width: number, height: number, x: number?, color: Color3?): BasePart
		local part = newPart("Part", {
			Size = Vector3.new(width, 2, length),
			Position = Vector3.new(x or 0, baseY + height - 1, -(cursor + length / 2)),
			Color = color or COLORS.Platform,
		}, course)
		cursor += length
		return part
	end

	local function gap(distance: number)
		cursor += distance
	end

	-- Puerta invisible (detector) en la posición actual del cursor
	local function gate(name: string, width: number, color: Color3, floorY: number): BasePart
		return newPart("Part", {
			Name = name,
			Size = Vector3.new(width, 10, 1),
			Position = Vector3.new(0, floorY + 5, -cursor),
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 0.6,
			CanCollide = false,
			CanQuery = false,
		}, course)
	end

	local function checkpoint(platform: BasePart)
		checkpointCount += 1
		local cp = newPart("Part", {
			Name = tostring(checkpointCount),
			Size = Vector3.new(platform.Size.X, 8, 2),
			CFrame = CFrame.new(platform.Position + Vector3.new(0, platform.Size.Y / 2 + 4, 0)),
			Color = COLORS.Checkpoint,
			Material = Enum.Material.Neon,
			Transparency = 0.6,
			CanCollide = false,
			CanQuery = false,
		}, checkpointsFolder)
		cp:SetAttribute("Index", checkpointCount)
	end

	-- Hueco con una pared al lado para correr por ella. side: -1 izquierda, 1 derecha
	local function wallRunSection(side: number, length: number): BasePart
		newPart("Part", {
			Name = "WallRun",
			Size = Vector3.new(2, 24, length + 8),
			Position = Vector3.new(side * 8, baseY + 6, -(cursor + length / 2)),
			Color = COLORS.Wall,
		}, course)
		gap(length)
		return block(16, 16, 0)
	end

	-- 1. Salida
	newPart("SpawnLocation", {
		Name = "Spawn",
		Size = Vector3.new(24, 2, 24),
		Position = Vector3.new(0, baseY - 1, -12),
		Color = COLORS.Runway,
		Neutral = true,
		Duration = 0,
	}, course)
	cursor = 24
	gate("Start", 24, COLORS.Start, baseY)

	-- 2. Pista para coger velocidad
	block(40, 12, 0, 0, COLORS.Runway)

	-- 3. Saltos entre plataformas
	local jumps = {
		{ x = 4, h = 1 },
		{ x = -4, h = 3 },
		{ x = 3, h = 5 },
		{ x = -3, h = 3 },
		{ x = 0, h = 1 },
	}
	for _, jump in jumps do
		gap(7)
		block(8, 8, jump.h, jump.x)
	end
	gap(7)
	checkpoint(block(16, 16, 0))

	-- 4. Doble wall run (izquierda y luego derecha)
	wallRunSection(-1, 34)
	checkpoint(wallRunSection(1, 34))

	-- 5. Rampa: hace falta ir rápido (o deslizarse) para pasar el hueco
	block(40, 10, 0, 0, COLORS.Runway)
	local rampLength, rampRise = 16, 6
	newPart("Part", {
		Name = "Ramp",
		Size = Vector3.new(10, 1, math.sqrt(rampLength ^ 2 + rampRise ^ 2)),
		CFrame = CFrame.new(0, baseY + rampRise / 2 - 0.5, -(cursor + rampLength / 2))
			* CFrame.Angles(math.atan2(rampRise, rampLength), 0, 0),
		Color = COLORS.Start,
	}, course)
	cursor += rampLength
	gap(18)
	checkpoint(block(20, 14, 2))

	-- 6. Escalera final
	local stairs = {
		{ x = -4, h = 6 },
		{ x = 4, h = 10 },
		{ x = -4, h = 14 },
		{ x = 2, h = 18 },
	}
	for _, step in stairs do
		gap(5)
		block(6, 6, step.h, step.x)
	end

	-- 7. Meta
	gap(6)
	gate("Finish", 24, COLORS.Finish, baseY + 20)
	block(24, 24, 20, 0, COLORS.Finish)

	-- Ranking global junto a la salida
	newPart("Part", {
		Name = "Leaderboard",
		Size = Vector3.new(14, 12, 1),
		CFrame = CFrame.lookAt(Vector3.new(16, baseY + 7, -12), Vector3.new(0, baseY + 7, -12)),
		Color = COLORS.Board,
	}, course)

	course.Parent = workspace
	return course
end

return CourseBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[-- Guarda los mejores tiempos (OrderedDataStore) y muestra el ranking global.
-- En Studio, activa "Enable Studio Access to API Services" para que se guarde.
-- Sin acceso a DataStore, el ranking sigue funcionando con los tiempos de la sesión.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Leaderboard = {}

local store: OrderedDataStore? = nil
pcall(function()
	store = DataStoreService:GetOrderedDataStore(Config.DataStoreName)
end)

local sessionBests: { [number]: number } = {}
local names: { [number]: string } = {}
local refreshCallbacks: { () -> () } = {}

local function getName(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	names[userId] = if ok then name else "Jugador"
	return names[userId]
end

-- Devuelve el mejor tiempo guardado (en segundos) o nil
function Leaderboard.loadBest(userId: number): number?
	if not store then
		return nil
	end
	local ok, value = pcall(function()
		return store:GetAsync(tostring(userId))
	end)
	if ok and typeof(value) == "number" then
		return value / 1000
	end
	return nil
end

function Leaderboard.submit(player: Player, seconds: number)
	local userId = player.UserId
	names[userId] = player.Name
	if not sessionBests[userId] or seconds < sessionBests[userId] then
		sessionBests[userId] = seconds
	end

	if store then
		local ms = math.floor(seconds * 1000 + 0.5)
		task.spawn(function()
			local ok, err = pcall(function()
				store:UpdateAsync(tostring(userId), function(old)
					if typeof(old) == "number" and old <= ms then
						return nil -- el récord guardado ya es mejor
					end
					return ms
				end)
			end)
			if not ok then
				warn("[Leaderboard] No se pudo guardar el tiempo:", err)
			end
		end)
	end

	for _, refresh in refreshCallbacks do
		task.spawn(refresh)
	end
end

export type Entry = { userId: number, name: string, seconds: number }

function Leaderboard.getTop(count: number): { Entry }
	local byUser: { [number]: number } = {}

	if store then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(true, count)
		end)
		if ok then
			for _, item in pages:GetCurrentPage() do
				local userId = tonumber(item.key)
				if userId then
					byUser[userId] = item.value / 1000
				end
			end
		end
	end

	for userId, seconds in sessionBests do
		if not byUser[userId] or seconds < byUser[userId] then
			byUser[userId] = seconds
		end
	end

	local list = {}
	for userId, seconds in byUser do
		table.insert(list, { userId = userId, seconds = seconds, name = "" })
	end
	table.sort(list, function(a, b)
		return a.seconds < b.seconds
	end)

	local result = {}
	for i = 1, math.min(count, #list) do
		local entry = list[i]
		entry.name = getName(entry.userId)
		result[i] = entry
	end
	return result
end

-- Crea un SurfaceGui con el top en la cara frontal de la Part
function Leaderboard.startBoard(part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 20)
	padding.PaddingLeft = UDim.new(0, 30)
	padding.PaddingRight = UDim.new(0, 30)
	padding.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 70)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 210, 0)
	title.Text = "🏆 MEJORES TIEMPOS"
	title.LayoutOrder = 0
	title.Parent = frame

	local rows = {}
	for i = 1, Config.LeaderboardSize do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, 0, 0, 34)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if i <= 3 then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(180, 180, 200)
		row.Text = string.format("%d. ---", i)
		row.LayoutOrder = i
		row.Parent = frame
		rows[i] = row
	end

	local refreshing = false
	local function refresh()
		if refreshing then
			return
		end
		refreshing = true
		local top = Leaderboard.getTop(Config.LeaderboardSize)
		for i, row in rows do
			local entry = top[i]
			row.Text = if entry
				then string.format("%d. %s  —  %s", i, entry.name, Config.FormatTime(entry.seconds))
				else string.format("%d. ---", i)
		end
		refreshing = false
	end
	table.insert(refreshCallbacks, refresh)

	task.spawn(function()
		while part.Parent do
			refresh()
			task.wait(Config.LeaderboardRefresh)
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">RaceService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Lógica de la carrera: salida, checkpoints, meta, caídas y récords.
-- El servidor es quien mide el tiempo oficial (el cliente solo lo muestra).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))
local Leaderboard = require(script.Parent:WaitForChild("Leaderboard"))

-- Remotes (se crean primero para que los clientes los encuentren)
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function newRemote(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local RaceStarted = newRemote("RaceStarted") -- (totalCheckpoints)
local CheckpointReached = newRemote("CheckpointReached") -- (index, total, splitTime)
local RaceFinished = newRemote("RaceFinished") -- (time, bestTime, isNewRecord)
local RaceCancelled = newRemote("RaceCancelled") -- (reason)
local RequestRestart = newRemote("RequestRestart")
remotes.Parent = ReplicatedStorage

-- Circuito
local course = workspace:FindFirstChild("Course") or CourseBuilder.build()
local spawnPart = course:WaitForChild("Spawn") :: BasePart
local startGate = course:WaitForChild("Start") :: BasePart
local finishGate = course:WaitForChild("Finish") :: BasePart

local checkpoints: { BasePart } = {}
for _, cp in course:WaitForChild("Checkpoints"):GetChildren() do
	local index = cp:GetAttribute("Index")
	if cp:IsA("BasePart") and typeof(index) == "number" then
		checkpoints[index] = cp
	end
end
local totalCheckpoints = #checkpoints

local board = course:FindFirstChild("Leaderboard")
if board and board:IsA("BasePart") then
	Leaderboard.startBoard(board)
end

type State = {
	racing: boolean,
	startTime: number,
	nextCheckpoint: number,
	respawnCFrame: CFrame,
	best: number?,
	lastStart: number,
	lastRestart: number,
}

local states: { [Player]: State } = {}

local function spawnCFrame(): CFrame
	return spawnPart.CFrame * CFrame.new(0, spawnPart.Size.Y / 2 + 3, 0)
end

local function checkpointCFrame(cp: BasePart): CFrame
	return cp.CFrame * CFrame.new(0, -cp.Size.Y / 2 + 3, 0)
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

local function teleport(player: Player, cframe: CFrame)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return
	end
	character:PivotTo(cframe)
	-- Avisa al script de movimiento del cliente para que resetee la velocidad
	player:SetAttribute("TeleportTick", (player:GetAttribute("TeleportTick") or 0) + 1)
end

local function setBest(player: Player, state: State, seconds: number)
	state.best = seconds
	player:SetAttribute("BestTime", seconds)
	local leaderstats = player:FindFirstChild("leaderstats")
	local value = leaderstats and leaderstats:FindFirstChild("Mejor")
	if value then
		(value :: StringValue).Value = Config.FormatTime(seconds)
	end
end

local function resetState(state: State)
	state.racing = false
	state.nextCheckpoint = 1
	state.respawnCFrame = spawnCFrame()
end

local function startRace(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.lastStart < 0.3 then
		return
	end
	state.lastStart = now
	state.racing = true
	state.startTime = now
	state.nextCheckpoint = 1
	state.respawnCFrame = spawnCFrame()
	RaceStarted:FireClient(player, totalCheckpoints)
end

local function reachCheckpoint(player: Player, index: number)
	local state = states[player]
	if not state or not state.racing or index ~= state.nextCheckpoint then
		return
	end
	state.nextCheckpoint += 1
	state.respawnCFrame = checkpointCFrame(checkpoints[index])
	CheckpointReached:FireClient(player, index, totalCheckpoints, os.clock() - state.startTime)
end

local function finishRace(player: Player)
	local state = states[player]
	if not state or not state.racing then
		return
	end
	if state.nextCheckpoint <= totalCheckpoints then
		return -- se ha saltado algún checkpoint
	end

	local elapsed = os.clock() - state.startTime
	resetState(state)

	if elapsed < Config.MinValidTime then
		RaceCancelled:FireClient(player, "Tiempo no válido")
		return
	end

	local isRecord = state.best == nil or elapsed < state.best
	if isRecord then
		setBest(player, state, elapsed)
		Leaderboard.submit(player, elapsed)
	end
	RaceFinished:FireClient(player, elapsed, state.best, isRecord)

	-- Vuelve a la salida tras unos segundos para otro intento
	task.delay(3, function()
		if states[player] == state and not state.racing then
			teleport(player, spawnCFrame())
		end
	end)
end

-- Detectores
startGate.Touched:Connect(function(hit)
	local player = playerFromHit(hit)
	if player then
		startRace(player)
	end
end)

finishGate.Touched:Connect(function(hit)
	local player = playerFromHit(hit)
	if player then
		finishRace(player)
	end
end)

for index, cp in checkpoints do
	cp.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player then
			reachCheckpoint(player, index)
		end
	end)
end

local killParts = course:FindFirstChild("KillParts")
if killParts then
	for _, part in killParts:GetDescendants() do
		if part:IsA("BasePart") then
			part.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if player and states[player] then
					teleport(player, states[player].respawnCFrame)
				end
			end)
		end
	end
end

-- Reiniciar (tecla R)
RequestRestart.OnServerEvent:Connect(function(player)
	local state = states[player]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.lastRestart < 0.5 then
		return
	end
	state.lastRestart = now
	resetState(state)
	RaceCancelled:FireClient(player, nil)
	teleport(player, spawnCFrame())
end)

-- Jugadores
local function onPlayerAdded(player: Player)
	local state: State = {
		racing = false,
		startTime = 0,
		nextCheckpoint = 1,
		respawnCFrame = spawnCFrame(),
		best = nil,
		lastStart = 0,
		lastRestart = 0,
	}
	states[player] = state

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local bestValue = Instance.new("StringValue")
	bestValue.Name = "Mejor"
	bestValue.Value = "--"
	bestValue.Parent = leaderstats
	leaderstats.Parent = player

	-- Si muere en mitad de la carrera, reaparece en su último checkpoint
	player.CharacterAdded:Connect(function(character)
		if state.racing then
			character:WaitForChild("HumanoidRootPart")
			task.wait()
			teleport(player, state.respawnCFrame)
		end
	end)

	task.spawn(function()
		local saved = Leaderboard.loadBest(player.UserId)
		if saved and states[player] == state and (state.best == nil or saved < state.best) then
			setBest(player, state, saved)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	onPlayerAdded(player)
end

Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
end)

-- Caídas al vacío
task.spawn(function()
	while true do
		for player, state in states do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and root.Position.Y < Config.FallY then
				teleport(player, state.respawnCFrame)
			end
		end
		task.wait(0.1)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="9">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Character</string>
        </Properties>
        <Item class="LocalScript" referent="11">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[-- Movimiento de parkour: momentum al correr, deslizamiento, wall run y wall jump.
-- Va en StarterCharacterScripts, así que se reinicia con cada personaje.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local character = script:FindFirstAncestorOfClass("Model") :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local root = character:WaitForChild("HumanoidRootPart") :: BasePart
local camera = workspace.CurrentCamera

local CAMERA_STEP = "ParkourCameraTilt"
local SLIDE_ACTION = "ParkourSlide"

humanoid.UseJumpPower = true
humanoid.JumpPower = Config.JumpPower
humanoid.WalkSpeed = Config.BaseWalkSpeed

-- Fuerza que usamos para pegarnos a la pared durante el wall run
local attachment = Instance.new("Attachment")
attachment.Name = "ParkourAttachment"
attachment.Parent = root

local wallVelocity = Instance.new("LinearVelocity")
wallVelocity.Attachment0 = attachment
wallVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
wallVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
wallVelocity.MaxForce = math.huge
wallVelocity.Enabled = false
wallVelocity.Parent = root

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = { character }

-- Estado
local currentSpeed = Config.BaseWalkSpeed
local slideEndTime = 0
local lastSlideTime = -math.huge
local wallRunning = false
local wallNormal = Vector3.zero
local wallTangent = Vector3.zero
local wallRunStart = 0
local lastWallRunEnd = -math.huge
local lastWall: Instance? = nil
local cameraTilt = 0

local function isGrounded(): boolean
	return humanoid.FloorMaterial ~= Enum.Material.Air
end

local function horizontalSpeed(): number
	local v = root.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

-- Deslizamiento ------------------------------------------------------------

local function trySlide()
	local now = os.clock()
	if now < slideEndTime or now - lastSlideTime < Config.SlideCooldown then
		return
	end
	if not isGrounded() or humanoid.MoveDirection.Magnitude < 0.1 then
		return
	end
	lastSlideTime = now
	slideEndTime = now + Config.SlideDuration
	-- El deslizamiento también deja buena parte del momentum ganado
	currentSpeed = math.max(currentSpeed, Config.BaseWalkSpeed + (Config.MaxWalkSpeed - Config.BaseWalkSpeed) * 0.75)
	humanoid.CameraOffset = Vector3.new(0, -1.5, 0)
end

ContextActionService:BindAction(SLIDE_ACTION, function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		trySlide()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
ContextActionService:SetTitle(SLIDE_ACTION, "Deslizar")
ContextActionService:SetPosition(SLIDE_ACTION, UDim2.new(1, -170, 1, -110))

-- Wall run -----------------------------------------------------------------

local function findWall(): RaycastResult?
	local right = root.CFrame.RightVector
	for _, side in { 1, -1 } do
		local result = workspace:Raycast(root.Position, right * side * Config.WallRunCheckDistance, rayParams)
		if result and math.abs(result.Normal.Y) < 0.2 then
			return result
		end
	end
	return nil
end

local function stopWallRun()
	if not wallRunning then
		return
	end
	wallRunning = false
	wallVelocity.Enabled = false
	lastWallRunEnd = os.clock()
end

local function tryStartWallRun()
	local now = os.clock()
	if wallRunning or isGrounded() or now - lastWallRunEnd < Config.WallRunCooldown then
		return
	end
	if humanoid.MoveDirection.Magnitude < 0.1 or horizontalSpeed() < Config.WallRunMinSpeed then
		return
	end

	local hit = findWall()
	if not hit then
		return
	end
	-- No volver a engancharse a la misma pared justo después de saltar de ella
	if hit.Instance == lastWall and now - lastWallRunEnd < 0.6 then
		return
	end

	local tangent = hit.Normal:Cross(Vector3.yAxis).Unit
	if tangent:Dot(root.CFrame.LookVector) < 0 then
		tangent = -tangent
	end

	wallRunning = true
	wallNormal = hit.Normal
	wallTangent = tangent
	wallRunStart = now
	lastWall = hit.Instance
	wallVelocity.Enabled = true
end

local function updateWallRun()
	local elapsed = os.clock() - wallRunStart
	local stillOnWall = workspace:Raycast(root.Position, -wallNormal * (Config.WallRunCheckDistance + 1), rayParams)

	if
		not stillOnWall
		or elapsed > Config.WallRunMaxTime
		or isGrounded()
		or humanoid.MoveDirection.Magnitude < 0.1
	then
		stopWallRun()
		return
	end

	local fall = Config.WallRunFallSpeed + elapsed * 8
	wallVelocity.VectorVelocity = wallTangent * Config.WallRunSpeed - wallNormal * 1 - Vector3.new(0, fall, 0)
end

-- Salto desde la pared
UserInputService.JumpRequest:Connect(function()
	if not wallRunning then
		return
	end
	stopWallRun()
	root.AssemblyLinearVelocity = wallNormal * Config.WallJumpOutForce
		+ Vector3.new(0, Config.WallJumpUpForce, 0)
		+ wallTangent * Config.WallRunSpeed * 0.8
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
end)

-- Bucle principal ------------------------------------------------------------

local connection = RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	local moving = humanoid.MoveDirection.Magnitude > 0.1

	-- Momentum: acelera corriendo en el suelo, se pierde al pararse
	if not moving then
		currentSpeed = Config.BaseWalkSpeed
	elseif isGrounded() then
		currentSpeed = math.min(currentSpeed + Config.Acceleration * dt, Config.MaxWalkSpeed)
	end

	if wallRunning then
		updateWallRun()
	else
		tryStartWallRun()
	end

	-- Velocidad final según la acción actual
	if wallRunning then
		humanoid.WalkSpeed = Config.WallRunSpeed
	elseif now < slideEndTime then
		local remaining = (slideEndTime - now) / Config.SlideDuration
		humanoid.WalkSpeed = currentSpeed + Config.SlideBoost * remaining
	else
		humanoid.WalkSpeed = currentSpeed
		if humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
		end
	end

	-- FOV según la velocidad
	local speedAlpha = math.clamp(
		(horizontalSpeed() - Config.BaseWalkSpeed) / (Config.WallRunSpeed - Config.BaseWalkSpeed),
		0,
		1
	)
	local targetFov = Config.BaseFOV + (Config.MaxFOV - Config.BaseFOV) * speedAlpha
	camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(dt * 6, 1)
end)

-- Inclinar la cámara durante el wall run (después de que la cámara se actualice)
pcall(RunService.UnbindFromRenderStep, RunService, CAMERA_STEP)
RunService:BindToRenderStep(CAMERA_STEP, Enum.RenderPriority.Camera.Value + 1, function(dt)
	local target = 0
	if wallRunning then
		local side = if wallNormal:Dot(camera.CFrame.RightVector) > 0 then 1 else -1
		target = math.rad(Config.WallRunCameraTilt) * side
	end
	cameraTilt += (target - cameraTilt) * math.min(dt * 10, 1)
	if math.abs(cameraTilt) > 0.001 then
		camera.CFrame *= CFrame.Angles(0, 0, cameraTilt)
	end
end)

-- Cuando el servidor nos teletransporta (checkpoint / reinicio), perdemos la velocidad
local teleportConnection = player:GetAttributeChangedSignal("TeleportTick"):Connect(function()
	stopWallRun()
	slideEndTime = 0
	currentSpeed = Config.BaseWalkSpeed
	root.AssemblyLinearVelocity = Vector3.zero
end)

local function cleanup()
	connection:Disconnect()
	teleportConnection:Disconnect()
	pcall(RunService.UnbindFromRenderStep, RunService, CAMERA_STEP)
	ContextActionService:UnbindAction(SLIDE_ACTION)
	camera.FieldOfView = Config.BaseFOV
end

humanoid.Died:Connect(cleanup)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="14">
          <Properties>
            <string name="Name">RaceHUD</string>
            <string name="Source"><![CDATA[-- Interfaz de la carrera: cronómetro, checkpoints, mejor tiempo y mensajes.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

-- Construcción de la UI -------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "RaceHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function label(props: { [string]: any }): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBlack
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.5
	text.TextScaled = true
	for key, value in props do
		(text :: any)[key] = value
	end
	text.Parent = gui
	return text
end

local timerLabel = label({
	Name = "Timer",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 50),
	Size = UDim2.new(0, 320, 0, 60),
	Text = Config.FormatTime(0),
})

local checkpointLabel = label({
	Name = "Checkpoint",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 112),
	Size = UDim2.new(0, 320, 0, 26),
	Font = Enum.Font.GothamBold,
	Text = "Cruza la salida azul para empezar",
})

local bestLabel = label({
	Name = "Best",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 140),
	Size = UDim2.new(0, 320, 0, 22),
	Font = Enum.Font.GothamBold,
	TextColor3 = Color3.fromRGB(255, 210, 0),
	Text = "Mejor: " .. Config.FormatTime(nil),
})

local popupLabel = label({
	Name = "Popup",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.35),
	Size = UDim2.new(0, 600, 0, 70),
	TextTransparency = 1,
	TextStrokeTransparency = 1,
})

label({
	Name = "Controls",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 16, 1, -16),
	Size = UDim2.new(0, 380, 0, 70),
	Font = Enum.Font.Gotham,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextTransparency = 0.2,
	Text = "Corre para ganar velocidad\nC / Ctrl: deslizar   ·   Salta hacia una pared: wall run\nEspacio en la pared: wall jump   ·   R: reiniciar",
})

-- Mensajes emergentes ---------------------------------------------------------

local popupTween: Tween? = nil
local function showPopup(text: string, color: Color3?)
	if popupTween then
		popupTween:Cancel()
	end
	popupLabel.Text = text
	popupLabel.TextColor3 = color or Color3.new(1, 1, 1)
	popupLabel.TextTransparency = 0
	popupLabel.TextStrokeTransparency = 0.4
	popupTween = TweenService:Create(
		popupLabel,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.6),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	)
	popupTween:Play()
end

-- Estado de la carrera ----------------------------------------------------------

local running = false
local startTime = 0

local function updateBest()
	bestLabel.Text = "Mejor: " .. Config.FormatTime(player:GetAttribute("BestTime"))
end
updateBest()
player:GetAttributeChangedSignal("BestTime"):Connect(updateBest)

RunService.RenderStepped:Connect(function()
	if running then
		timerLabel.Text = Config.FormatTime(os.clock() - startTime)
	end
end)

remotes:WaitForChild("RaceStarted").OnClientEvent:Connect(function(total: number)
	running = true
	startTime = os.clock()
	timerLabel.TextColor3 = Color3.new(1, 1, 1)
	checkpointLabel.Text = string.format("Checkpoint 0/%d", total)
end)

remotes:WaitForChild("CheckpointReached").OnClientEvent:Connect(function(index: number, total: number, split: number)
	checkpointLabel.Text = string.format("Checkpoint %d/%d", index, total)
	showPopup(string.format("Checkpoint %d  ·  %s", index, Config.FormatTime(split)), Color3.fromRGB(0, 255, 140))
end)

remotes:WaitForChild("RaceFinished").OnClientEvent:Connect(function(time: number, best: number, isRecord: boolean)
	running = false
	timerLabel.Text = Config.FormatTime(time) -- tiempo oficial del servidor
	checkpointLabel.Text = "¡Meta!"
	if isRecord then
		timerLabel.TextColor3 = Color3.fromRGB(255, 210, 0)
		showPopup("¡NUEVO RÉCORD!  " .. Config.FormatTime(time), Color3.fromRGB(255, 210, 0))
	else
		local diff = time - best
		showPopup(string.format("%s  (+%.3f)", Config.FormatTime(time), diff), Color3.fromRGB(255, 120, 120))
	end
end)

remotes:WaitForChild("RaceCancelled").OnClientEvent:Connect(function(reason: string?)
	running = false
	timerLabel.Text = Config.FormatTime(0)
	timerLabel.TextColor3 = Color3.new(1, 1, 1)
	checkpointLabel.Text = "Cruza la salida azul para empezar"
	if reason then
		showPopup(reason, Color3.fromRGB(255, 120, 120))
	end
end)

-- Reiniciar ---------------------------------------------------------------------

local requestRestart = remotes:WaitForChild("RequestRestart") :: RemoteEvent
ContextActionService:BindAction("ParkourRestart", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		requestRestart:FireServer()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
ContextActionService:SetTitle("ParkourRestart", "Reiniciar")
ContextActionService:SetPosition("ParkourRestart", UDim2.new(1, -170, 1, -170))
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>