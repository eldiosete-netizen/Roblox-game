      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[-- Objetos de la tienda (solo estéticos: no dan ventaja en las carreras).

local Catalog = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

export type Item = {
	id: string,
	kind: string, -- "Trail", "Jump" o "Slide"
	name: string,
	price: number,
	vip: boolean?,
	colors: { Color3 },
}

Catalog.Kinds = {
	{ id = "Trail", name = "Rastros" },
	{ id = "Jump", name = "Salto" },
	{ id = "Slide", name = "Deslizar" },
}

Catalog.Items = {
	-- Rastros (se ven a alta velocidad; los ven todos los jugadores)
	{ id = "trail_blue", kind = "Trail", name = "Eléctrico", price = 0, colors = { rgb(0, 200, 255), rgb(170, 80, 255) } },
	{ id = "trail_fire", kind = "Trail", name = "Fuego", price = 150, colors = { rgb(255, 220, 0), rgb(255, 60, 0) } },
	{ id = "trail_toxic", kind = "Trail", name = "Tóxico", price = 300, colors = { rgb(180, 255, 0), rgb(0, 160, 60) } },
	{ id = "trail_ice", kind = "Trail", name = "Hielo", price = 450, colors = { rgb(255, 255, 255), rgb(120, 200, 255) } },
	{ id = "trail_gold", kind = "Trail", name = "Oro", price = 800, colors = { rgb(255, 240, 150), rgb(255, 170, 0) } },
	{
		id = "trail_rainbow",
		kind = "Trail",
		name = "Arcoíris",
		price = 1500,
		colors = { rgb(255, 60, 60), rgb(255, 170, 0), rgb(255, 240, 0), rgb(0, 220, 90), rgb(0, 150, 255), rgb(170, 70, 255) },
	},
	{
		id = "trail_galaxy",
		kind = "Trail",
		name = "Galaxia",
		price = 0,
		vip = true,
		colors = { rgb(255, 80, 220), rgb(80, 40, 200), rgb(10, 10, 60) },
	},

	-- Efecto al saltar
	{ id = "jump_none", kind = "Jump", name = "Ninguno", price = 0, colors = { rgb(90, 90, 100) } },
	{ id = "jump_sparks", kind = "Jump", name = "Chispas", price = 100, colors = { rgb(255, 240, 80), rgb(255, 140, 0) } },
	{ id = "jump_frost", kind = "Jump", name = "Escarcha", price = 250, colors = { rgb(255, 255, 255), rgb(140, 210, 255) } },
	{ id = "jump_toxic", kind = "Jump", name = "Veneno", price = 400, colors = { rgb(160, 255, 0), rgb(0, 140, 40) } },
	{ id = "jump_stars", kind = "Jump", name = "Estrellas", price = 0, vip = true, colors = { rgb(255, 215, 0), rgb(255, 255, 255) } },

	-- Efecto al deslizar
	{ id = "slide_dust", kind = "Slide", name = "Polvo", price = 0, colors = { rgb(220, 220, 230) } },
	{ id = "slide_fire", kind = "Slide", name = "Llamas", price = 200, colors = { rgb(255, 200, 0), rgb(255, 50, 0) } },
	{ id = "slide_neon", kind = "Slide", name = "Neón", price = 350, colors = { rgb(0, 255, 230), rgb(255, 0, 200) } },
	{ id = "slide_gold", kind = "Slide", name = "Oro", price = 0, vip = true, colors = { rgb(255, 215, 0) } },
} :: { Item }

Catalog.Defaults = {
	Trail = "trail_blue",
	Jump = "jump_none",
	Slide = "slide_dust",
}

Catalog.byId = {} :: { [string]: Item }
for _, item in Catalog.Items do
	Catalog.byId[item.id] = item
end

function Catalog.colorSequence(item: Item): ColorSequence
	local colors = item.colors
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local keypoints = {}
	for i, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(keypoints)
end

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Configuración compartida entre servidor y cliente.
-- Cambia estos valores para ajustar cómo se siente el juego.

local Config = {
	-- Versión del juego (se ve en el menú de inicio y abajo a la derecha)
	Version = "1.9",

	-- Movimiento
	BaseWalkSpeed = 16, -- velocidad al empezar a correr
	MaxWalkSpeed = 34, -- velocidad máxima corriendo (momentum)
	Acceleration = 9, -- cuánto sube la velocidad por segundo corriendo en el suelo
	JumpPower = 55,

	-- Deslizamiento (C / Ctrl)
	SlideBoost = 20, -- velocidad extra al inicio del deslizamiento
	SlideDuration = 0.6,
	SlideCooldown = 1.2,

	-- Correr por paredes
	WallRunSpeed = 38,
	WallRunMaxTime = 1.6,
	WallRunFallSpeed = 3, -- caída inicial durante el wall run (aumenta con el tiempo)
	WallRunCheckDistance = 3,
	WallRunMinSpeed = 10, -- velocidad horizontal mínima para engancharse a una pared
	WallRunCooldown = 0.25,
	WallJumpOutForce = 40,
	WallJumpUpForce = 52,
	WallRunCameraTilt = 12, -- grados

	-- Cámara
	BaseFOV = 70,
	MaxFOV = 92,

	-- Efectos
	TrailSpeed = 28, -- a partir de esta velocidad aparece el rastro
	HardLandingSpeed = 60, -- caídas más rápidas que esto hacen temblar la cámara
	SlidePoseLean = 55, -- grados que se inclina el cuerpo hacia atrás al deslizar
	WallRunPoseLean = 20, -- grados que se inclina el cuerpo hacia la pared

	-- Sonidos (cámbialos por IDs de la Creator Store: "rbxassetid://123456")
	Sounds = {
		Countdown = "rbxasset://sounds/electronicpingshort.wav",
		Go = "rbxasset://sounds/electronicpingshort.wav",
		Checkpoint = "rbxasset://sounds/electronicpingshort.wav",
		Finish = "rbxasset://sounds/victory.wav",
		Record = "rbxasset://sounds/victory.wav",
		Slide = "rbxasset://sounds/swoosh.wav",
		WallJump = "rbxasset://sounds/swoosh.wav",
		Land = "rbxasset://sounds/action_jump_land.mp3",
		Wind = "rbxasset://sounds/action_falling.mp3",
		Bounce = "rbxasset://sounds/action_jump.mp3",
		Medal = "rbxasset://sounds/electronicpingshort.wav",
	},

	-- Carrera
	CountdownSeconds = 3,
	CourseHeight = 50, -- altura a la que se generan lobby y mapas
	MapSpacing = 300, -- separación entre mapas generados
	FallY = 20, -- si caes por debajo de esta Y, vuelves al último checkpoint
	MinValidTime = 5, -- tiempos más rápidos se consideran trampa
	LeaderboardSize = 8,
	LeaderboardRefresh = 120, -- segundos entre lecturas del ranking global

	-- Obstáculos
	TrampolinePower = 110,
	LowGravityFactor = 0.35, -- 1 = gravedad normal
	ZiplineMinSpeed = 30,
	ZiplineMaxSpeed = 70,
	ZiplineGrabDistance = 3.5,

	-- Fantasma (tu mejor intento)
	GhostSampleInterval = 0.1, -- segundos entre posiciones grabadas
	GhostMaxSamples = 3000, -- 5 minutos como máximo
	GhostColor = Color3.fromRGB(120, 220, 255),

	-- Carrera en vivo (todos a la vez)
	LiveRace = {
		MinPlayers = 2, -- ponlo a 1 para probar solo en Studio
		Intermission = 15, -- segundos de espera antes de empezar
		TimeLimit = 180, -- segundos máximos de carrera
	},

	-- Recompensas
	Rewards = {
		FinishCoins = 10,
		FirstFinishCoins = 25, -- la primera vez que terminas un mapa
		RecordCoins = 5,
		MedalCoins = { 15, 30, 60, 150 }, -- bronce, plata, oro, desarrollador (solo la primera vez)
		FinishXP = 40,
		MedalXP = 20, -- por cada nivel de medalla conseguido en la carrera
		RecordXP = 20,
		LivePlaceCoins = { 50, 30, 20 }, -- 1º, 2º y 3º en carrera en vivo
		LiveParticipationCoins = 10,
		LiveXP = 30,
		TutorialCoins = 50,
	},

	-- VIP (Game Pass). Crea el pase en el Creator Hub y pon aquí su ID.
	VipGamePassId = 0,
	VipCoinMultiplier = 1.5,

	-- Ajustes por defecto del jugador
	DefaultSettings = {
		shake = true, -- temblor de cámara
		fov = true, -- efecto de velocidad en la cámara
		ghost = true, -- mostrar el fantasma
		wind = true, -- sonido de viento
		hints = true, -- mostrar controles en pantalla
	},

	-- Guardado
	DataStores = {
		Player = "PlayerData_v1",
		TimesPrefix = "Times_v1_",
		Ghosts = "Ghosts_v1",
	},
	AutosaveInterval = 120,
}

-- Medallas de mejor a peor. El tiempo de cada una se define por mapa.
Config.Medals = {
	{ id = "Dev", name = "Desarrollador", color = Color3.fromRGB(200, 90, 255) },
	{ id = "Gold", name = "Oro", color = Color3.fromRGB(255, 205, 40) },
	{ id = "Silver", name = "Plata", color = Color3.fromRGB(200, 210, 225) },
	{ id = "Bronze", name = "Bronce", color = Color3.fromRGB(205, 127, 70) },
}

-- Rango de medalla: 4 = Desarrollador, 3 = Oro, 2 = Plata, 1 = Bronce, 0 = ninguna
function Config.MedalRank(seconds: number, times: { [string]: number }): number
	for i, medal in Config.Medals do
		local limit = times[medal.id]
		if limit and seconds <= limit then
			return #Config.Medals - i + 1
		end
	end
	return 0
end

function Config.MedalInfo(rank: number)
	return Config.Medals[#Config.Medals - rank + 1]
end

-- Nivel a partir de la XP total. Devuelve: nivel, XP dentro del nivel, XP para subir
function Config.LevelFromXP(xp: number): (number, number, number)
	local level = 1
	local needed = 100
	while xp >= needed do
		xp -= needed
		level += 1
		needed = 100 + 50 * (level - 1)
	end
	return level, xp, needed
end

function Config.FormatTime(seconds: number?): string
	if not seconds then
		return "--:--.---"
	end
	local minutes = math.floor(seconds / 60)
	local rest = seconds - minutes * 60
	return string.format("%02d:%06.3f", minutes, rest)
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Todos los RemoteEvents/RemoteFunctions del juego en un solo sitio.
-- El servidor los crea; el cliente espera a que existan.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	-- Carrera
	"RaceCountdown", -- (mapId, seconds)
	"RaceStarted", -- (mapId, totalCheckpoints, mode)
	"CheckpointReached", -- (index, total, split, delta?)
	"RaceFinished", -- (result)
	"RaceCancelled", -- (reason?)
	"RequestRestart",
	"ReturnToLobby",
	-- Datos
	"DataSync", -- (snapshot)
	"Notify", -- (text, color?)
	"UpdateSetting", -- (key, value)
	-- Competición
	"GhostData", -- (mapId, encoded?)
	"SubmitGhost", -- (mapId, encoded)
	"LiveRaceUpdate", -- (status)
}

local FUNCTIONS = {
	"RequestMap", -- (mapId) -> ok, message
	"SetLiveRaceQueue", -- (join) -> ok, message
	"Purchase", -- (itemId) -> ok, message
	"Equip", -- (itemId) -> ok, message
	"GetLeaderboard", -- (mapId) -> { all = entries, week = entries }
}

local Remotes = {}

if RunService:IsServer() then
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes :: { [string]: any }
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Sfx</string>
          <string name="Source"><![CDATA[-- Reproduce sonidos 2D en el cliente (solo los oye el jugador local).

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local Config = require(script.Parent:WaitForChild("Config"))

local Sfx = {}

function Sfx.create(name: string, volume: number?): Sound?
	local id = Config.Sounds[name]
	if not id or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Volume = volume or 0.6
	sound.Parent = SoundService
	return sound
end

function Sfx.play(name: string, playbackSpeed: number?, volume: number?)
	local sound = Sfx.create(name, volume)
	if not sound then
		return
	end
	sound.PlaybackSpeed = playbackSpeed or 1
	sound:Play()
	Debris:AddItem(sound, 10)
end

return Sfx
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
